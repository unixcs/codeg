#!/usr/bin/env node
// zcode-acp-bridge — ACP (Agent Client Protocol) agent ⇄ ZCode Protocol (zcode app-server --stdio) 适配器
// v0.4.0。v0.1 是最小消息直通桥；v0.2 对齐 codeg 0.35.x 的 config option 机制并补齐 /compact；
// v0.3 吸收两轮对抗审查的加固：inputId turn 精确归属、spawn 全局并发闸、跨 workspace 归属校验、
// 看门狗补发 session/stop、日志 0600/redact 扩展、权限选项 kind 白名单、backlog/背压保险丝；
// v0.4 吸收 R7/R8 两轮审查 + 真机（zcode 3.14.3）探针实证：interaction/requestPermission 直答、
// 并发 load/resume 单飞、-32010 短退避重试、legacy 兜底缓冲、权限止损归属、redact 扩展。
//
// v0.2 新增（对齐 codeg 的 config option 机制，零宿主改动）：
//   1. 模型选择器：session/new 响应携带 configOptions（id="model" + category="model" 的 select，
//      平铺 type/currentValue/options；多 provider 时用 v1 的分组 options:[{group,name,options}]），
//      并处理宿主回发的 session/set_config_option → zcode session/setModel。
//   2. 思考深度选择器：configOptions 里的 id="reasoning_effort" → zcode session/setThoughtLevel。
//   3. /compact 手动压缩：available_commands_update 宣告；prompt 首文本块命中 /compact 时拦截，
//      调 zcode session/compact（异步 turn），以 compaction_update 卡片回报生命周期。
//      ⚠️ "/compact" 是保留前缀：用户正文以 /compact 开头会被本桥拦截而不发往 zcode。
//   4. 模型清单三层合并：BRIDGE_MODELS（手动）∪ session/read available（实时）∪
//      $BRIDGE_ZCODE_HOME/.zcode/v2/provider_config.json（zcode 配置全量，默认截 top:16）。
//
// v0.3 新增：
//   5. turn 归属升级为 inputId 精确匹配（zcode 3.14+ 的 session/send|compact 接受 params.inputId
//      并在 turn.started/completed/failed 中回显）；无 inputId 的旧 zcode 走原三重身份判定兜底。
//      cancel/看门狗收掉的轮其 inputId 转 foreignInputIds 追踪，迟到终结用于 already_running 跟随收口。
//   6. respawn 恢复宿主显式模式选择（explicitMode），不再强制切 yolo。
//   7. 思考深度选项 category 改为 ACP 原生 "thought_level"（"model" 会被 codeg
//      isModelConfigOption 误并入模型选择器分组）。
//
// v0.4 新增（R7/R8 对抗审查吸收 + 真机实证）：
//   8. 权限交互直答：zcode 3.14+ 对权限发双向竞速（interaction/requestPermission 请求 vs
//      v4 resolveInteraction，先到先得、晚到 noop）。桥此前对反向请求一律 -32601——错误应答
//      会让交互立即判 failed（真机实测 decision=deny），allow 档事件侧 resolveInteraction
//      永远赶不上。现在直接应答请求（allow 档回 allow 档位的 response，deny 档同理），
//      事件侧 resolveInteraction 保留作幂等兜底。
//   9. 权限止损归属：payload 无 inputId（3.14.3 实测），用 toolCallId ∈ seenToolCalls 作证
//      （工具卡事件先于权限请求到达，真机实测）。判定为外来轮（僵尸轮补发）的权限不再触发
//      session/stop（会话级，会误杀健康在飞轮）/endTurn（会把当前 waiter 误标 refusal）。
//  10. 并发 load/resume 同一 zsid 单飞去重（防双 spawn 双回放 + 后入册覆盖漏收尸）；入册前
//      kill 同 zsid 旧条目子进程；close 与在飞 load/resume 竞速时完成后不入册直接收尸。
//  11. session/send|compact 被拒 -32010（上一轮终结未落，紧邻 cancel 常见）时短退避重试；
//      最终失败不再把从未开跑的 inputId 转 foreign 追踪。
//  12. 旧 zcode（事件无 inputId）的 already_running 同 chunk 兜底：pendingTurnOp 窗口内到达的
//      无主终结缓存为 foreign 候选，already_running 响应后重放收口（accepted 时随收口作废）。
//  13. 中间事件（delta/tool/message part）带 inputId 时按归属过滤（3.14.3 实测中间事件不带
//      inputId，此为未来版本兼容 + 防僵尸流污染）；无主 inputId 事件不刷新闲置回收计时。
//  14. redact() 补 Google AIza / github_pat_ / Slack xox* / AWS secret 形态；ACP 解析错误日志
//      只记长度+首 16 字节 hex（此前唯一落"正文前 200 字节"的汇点）。
//  15. inputId 序号改进程级单调（close→load 复用 sessionId 时不再撞号）。
// 用法（Codeg 自定义 agent / 其他 ACP 宿主的 agent 配置）：
//   { "name": "zcode", "brief": "...", "command": "zcode-acp-bridge", "protocol": "acp", "args": [] }
// 环境变量：
//   BRIDGE_PERMISSION_MODE   = allow（默认，切 yolo 模式全放行）| deny（保持默认模式，权限请求一律拒；
//                              未知值按 deny 处理并告警）
//   BRIDGE_ZCODE_BIN         = zcode 可执行名/路径（默认 "zcode"；多实例时指向各运行时）
//   BRIDGE_ZCODE_HOME        = 传给 app-server 的 HOME（借用某实例的配置目录/登录态；缺省继承本进程 HOME）。
//                              ⚠️ provider_config.json 也按此 HOME 解析——桥进程自身的 HOME 不会随之改变。
//   BRIDGE_MODELS            = 逗号分隔的手动模型清单，如 "kimi-k3@low,cn:glm-5.3-flash@max"
//                              （格式 modelId[@reasoningLevel]；provider 取会话当前 provider。排最前。）
//   BRIDGE_DEFAULT_MODEL     = 会话建立时默认切到的模型（格式同上；缺省取 BRIDGE_MODELS 第一项）
//   BRIDGE_CONFIG_MODELS     = 配置层清单开关/截断："top:N"（默认 top:16）| "all" | "off"
//                              （多 provider 实例建议 "all"，全局截断会挤掉 providerOrder 靠后的组）
//   BRIDGE_CONFIG_OPTIONS    = on（默认）| off —— off 即 v0.1 兼容档：不发任何 configOptions
//                              （响应内嵌与推送都不发），模式走 modes/set_mode、模型走 models/set_model
//                              通道，并隐含 BRIDGE_COMPACT=off（老宿主一键回退 v0.1 语义）
//   BRIDGE_COMPACT           = on（默认）| off —— 是否宣告并接管 /compact
//   BRIDGE_THOUGHT_LEVEL     = on（默认）| off —— 是否暴露思考深度选择器
//   BRIDGE_LOG_DIR           = 日志目录（缺省 mkdtemp 到系统临时目录，0700；显式指定时由操作员负责权限）
//   BRIDGE_TURN_WATCHDOG_MS  = turn 收口看门狗（默认 1500000 = 25min）
// 纪律：
//   - stderr 绝不输出含 "code":"..."+"message":"..." 形状的行（部分宿主会据此取消在飞 prompt）；日志进文件。
//   - 日志会记录事件元数据与 zcode stderr（已脱敏密钥），不记录 prompt/回复正文。
//   - 无第三方依赖，Node >= 18。
//
// 规范偏离声明：ACP session-compaction RFD 要求 client 宣告 clientCapabilities.session.compaction
// 后 agent 才可发送 compaction_update。codeg 只对 ClaudeCode|Codex 宣告该能力，但其消费路径
// （connection.rs session_compaction_event）对任意 agent 的入站帧均解析；经审查，桥对 codeg
// 始终发送 compaction_update（status ∈ in_progress|completed|failed，不用 cancelled）。

import { spawn } from 'node:child_process';
import { mkdirSync, appendFileSync, statSync, renameSync, readFileSync, existsSync, openSync, closeSync, mkdtempSync, chmodSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';

// 版本探测：ACP 宿主（Codeg 等）preflight 会跑 `agent --version`；不处理会挂在 stdio 等输入
if (process.argv.some(a => a === '--version' || a === '-V' || a === '-v')) {
  console.log('zcode-acp-bridge 0.4.0');
  process.exit(0);
}

const PERM_MODE_RAW = (process.env.BRIDGE_PERMISSION_MODE || 'allow').toLowerCase();
const PERM_MODE = PERM_MODE_RAW === 'allow' ? 'allow' : PERM_MODE_RAW === 'deny' ? 'deny' : 'deny'; // 未知值按 deny（安全侧）
const ZCODE_BIN = process.env.BRIDGE_ZCODE_BIN || 'zcode';
const ZCODE_HOME = process.env.BRIDGE_ZCODE_HOME || undefined;
const LOG_DIR_EXPLICIT = process.env.BRIDGE_LOG_DIR || undefined;
// BRIDGE_CONFIG_OPTIONS=off：v0.1 兼容档（MindFS 等老宿主一键回退）——
// 不发任何 configOptions（内嵌与推送），模式选择回 modes/set_mode 通道，
// 隐含 BRIDGE_COMPACT=off（available_commands_update 与 compaction_update 都是 v0.1 后新增的通知类型）
const CONFIG_OPTIONS_ON = (process.env.BRIDGE_CONFIG_OPTIONS || 'on').toLowerCase() !== 'off';
const COMPACT_ON = (process.env.BRIDGE_COMPACT || 'on').toLowerCase() !== 'off' && CONFIG_OPTIONS_ON;
const THOUGHT_ON = (process.env.BRIDGE_THOUGHT_LEVEL || 'on').toLowerCase() !== 'off';
const SEP = '\u241f'; // ␟ 单元分隔符：provider␟model[␟level]，拆分安全（两字段本身可含冒号）
// 数值型 env：非法/越界一律回默认并夹紧（负数会让 setTimeout 立即开火——每轮秒收/每分钟全杀）
function parseMsEnv(raw, def, min) {
  const n = parseInt(raw, 10);
  return Number.isFinite(n) && n >= min ? n : def;
}
const TURN_WATCHDOG_MS = parseMsEnv(process.env.BRIDGE_TURN_WATCHDOG_MS, 25 * 60 * 1000, 5000);
const PROMPT_MAX_CHARS = 2 * 1024 * 1024; // 宿主 prompt 总文本上限（防 OOM）
const LINE_BUF_MAX = 16 * 1024 * 1024;    // 单行 NDJSON 缓冲上限
const MAX_CONCURRENT_SPAWNS = 8;          // 全局并发 zcode 子进程闸（每个 ~300MB；new/load/resume/respawn 全过闸）

// BRIDGE_CONFIG_MODELS 解析：off | all | top:N（默认 16）
const CONFIG_MODELS_RAW = (process.env.BRIDGE_CONFIG_MODELS || 'top:16').trim().toLowerCase();
const CONFIG_MODELS = CONFIG_MODELS_RAW === 'off' ? { mode: 'off' }
  : CONFIG_MODELS_RAW === 'all' ? { mode: 'all' }
  : /^top:\d+$/.test(CONFIG_MODELS_RAW) ? { mode: 'top', limit: Math.max(1, parseInt(CONFIG_MODELS_RAW.slice(4), 10)) }
  : null;
const CONFIG_MODELS_EFF =
  // v0.1 兼容档默认真正对齐 v0.1 的两层 models 块（config 层是 v0.2 新增），除非显式给了 BRIDGE_CONFIG_MODELS
  (!CONFIG_OPTIONS_ON && process.env.BRIDGE_CONFIG_MODELS === undefined) ? { mode: 'off' }
  : CONFIG_MODELS || { mode: 'top', limit: 16 };

// "kimi-k3@low,cn:glm-5.3-flash@max" -> [{modelId:'kimi-k3', level:'low'}, ...]
const ENV_MODELS = (process.env.BRIDGE_MODELS || '').split(',').map(x => x.trim()).filter(Boolean)
  .map(entry => {
    const at = entry.indexOf('@');
    return at < 0 ? { modelId: entry, level: undefined } : { modelId: entry.slice(0, at), level: entry.slice(at + 1) };
  });
const DEFAULT_MODEL = process.env.BRIDGE_DEFAULT_MODEL || (ENV_MODELS[0]
  ? (ENV_MODELS[0].level ? `${ENV_MODELS[0].modelId}@${ENV_MODELS[0].level}` : ENV_MODELS[0].modelId)
  : undefined);
const ACP_PROTOCOL_VERSION = 1;
const ZCODE_MODES = [
  { id: 'plan', name: 'Plan（只读规划）', kind: 'read' },
  { id: 'build', name: 'Build（写前确认）', kind: 'execute' },
  { id: 'edit', name: 'Edit（自动改文件）', kind: 'edit' },
  { id: 'yolo', name: 'YOLO（全放行）', kind: 'execute' },
  { id: 'auto', name: 'Auto（自动）', kind: 'execute' },
];
const COMPACT_COMMANDS = [{ name: 'compact', description: '手动压缩上下文（zcode /compact，可带指示文字）' }];
const COMPACT_RE = /^\/compact(?:\s+([\s\S]+))?$/i;

// 日志目录：缺省 mkdtemp（0700、路径不可预测，防 /tmp 固定名符号链接攻击）；显式指定尊重操作员。
let LOG_DIR = LOG_DIR_EXPLICIT;
if (!LOG_DIR) {
  try { LOG_DIR = mkdtempSync(join(tmpdir(), 'zcode-acp-bridge-')); } catch { LOG_DIR = ''; }
}
try { if (LOG_DIR) mkdirSync(LOG_DIR, { recursive: true, mode: 0o700 }); } catch {}
const LOG_FILE = LOG_DIR ? join(LOG_DIR, `bridge-${process.pid}.log`) : '';
try { if (LOG_FILE) closeSync(openSync(LOG_FILE, 'a', 0o600)); } catch {}
// 落盘脱敏：密钥形态打码 + 单行化（防日志注入）。词表按"误伤优于漏报"取舍，覆盖：
// OpenAI(sk-,sk-ant-)/Bearer/Authorization、api_key 形态、query 里的 key/token、access/auth token、
// AWS AKIA/ASIA 与 aws_secret_access_key、GitHub token(ghp_/gho_/ghu_/ghs_/ghr_/github_pat_)、
// Google AIza、Slack xox*、JWT 三段式、cookie/secret/password。
// 不做高熵兜底：会把 sessionId/messageId 等关联 id 全部打码，日志失去排查价值——已知前缀 +
// 键值形态已覆盖主流凭据，残余风险由"日志不落正文"纪律兜底（R8-M1 权衡）。
function redact(s) {
  return String(s)
    .replace(/\b(sk-[A-Za-z0-9_-]{8,}|Bearer\s+\S+|api[_-]?key["'=:\s]+\S+|Authorization:\s*\S+|Authorization\s+\S+)\s*/gi, '[redacted] ')
    .replace(/[?&](key|token|access_token|api_key|apikey|sig|signature)=\S+/gi, '[redacted]')
    .replace(/\b((access|auth|session|id|refresh)[_-]?token|secret|password|passwd|pwd|cookie)["'=:\s]+\S+/gi, '[redacted]')
    .replace(/\baws_?secret_?access_?key["'=:\s]+\S+/gi, '[redacted]')
    .replace(/\b(AKIA|ASIA)[A-Z0-9]{16}\b/g, '[redacted]')
    .replace(/\b(?:gh[pousr]_|github_pat_)[A-Za-z0-9_]{20,}\b/g, '[redacted]')
    .replace(/\bAIza[A-Za-z0-9_-]{30,}\b/g, '[redacted]')
    .replace(/\bxox[abprs]-[A-Za-z0-9-]{10,}\b/g, '[redacted]')
    .replace(/\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{5,}\b/g, '[redacted]')
    .replace(/\s*\n\s*/g, ' ⏎ ');
}
function log(...args) {
  if (!LOG_FILE) return;
  try {
    // 单文件超 8MB 滚一份 .old，防小盘被长跑日志吃穿（回收型进程每会话一个，双文件封顶 ~16MB）
    try { if (statSync(LOG_FILE).size > 8 * 1024 * 1024) renameSync(LOG_FILE, LOG_FILE.replace(/\.log$/, '.old.log')); } catch {}
    // 非字符串参数 stringify 后同样过 redact（对象字段值可能是密钥/正文片段）；0600 防轮转重建后权限漂移
    // （appendFileSync 的 mode 只在"创建"时生效——回退分支也必须带，否则 umask 0644 落地，R8-m2）
    const line = args.map(a => redact(typeof a === 'string' ? a : JSON.stringify(a))).join(' ');
    try { appendFileSync(LOG_FILE, `[${new Date().toISOString()}] ${line}\n`, { mode: 0o600 }); }
    catch { try { appendFileSync(LOG_FILE, `[${new Date().toISOString()}] ${line}\n`, { mode: 0o600 }); chmodSync(LOG_FILE, 0o600); } catch {} }
  } catch {}
}
log('bridge start', { pid: process.pid, PERM_MODE, ZCODE_BIN, COMPACT_ON, THOUGHT_ON, CONFIG_MODELS_EFF });
if (!CONFIG_MODELS) log('BRIDGE_CONFIG_MODELS invalid, falling back to top:16:', CONFIG_MODELS_RAW);
if (PERM_MODE !== PERM_MODE_RAW) log('BRIDGE_PERMISSION_MODE invalid, using deny:', PERM_MODE_RAW);

// ---------- ACP 侧输出（stdout NDJSON，标准 JSON-RPC 2.0 信封） ----------
// 注意两侧不对称：ACP/JSON-RPC 侧带 "jsonrpc":"2.0"（Codeg Rust serde 可能强校验）；
// zcode 侧（zcodeSend）绝不能带——zcode app-server 对含 jsonrpc 字段的行静默丢弃。
function acpSend(msg) {
  // 出向背压：宿主读停 + 长流式 turn 时 Node 流缓冲无界增长。超 8MB 只丢低价值 delta 帧，
  // 语义帧（收口/卡片/工具终态）必达——丢 delta 只影响打字机效果，不影响最终内容
  if (process.stdout.writableLength > 8 * 1024 * 1024) {
    const su = msg.method === 'session/update' ? msg.params?.update?.sessionUpdate : '';
    if (su === 'agent_message_chunk' || su === 'agent_thought_chunk') return;
  }
  process.stdout.write(JSON.stringify({ jsonrpc: '2.0', ...msg }) + '\n');
}

// ---------- ACP 会话状态 ----------
// sessionId(ACP=zcode 原生 sessionId) -> { zc, zsid, cwd, workspaceKey, models, currentModelId,
//   currentMode, thoughtLevels, liveModels, providerId, seenToolCalls, partStarted, turnWaiter,
//   compaction, compactSeq, opQueue, stopReason, closed }
const sessions = new Map();
const allChildren = new Set(); // 全量子进程登记：会话条目被覆盖/删除后仍能收尸，防 ~300MB 孤儿
let spawningCount = 0;         // 全局并发 zcode 子进程闸（new/load/resume/respawn 全过闸）
const sessionCwds = new Map(); // zsid → cwd 归属登记：load/resume 拒绝跨 workspace 挂会话（桥生命周期内有效）
let INPUT_SEQ = 0;             // 进程级 turn 序号：inputId 由 zsid + 它组成，close→load 复用 sessionId 也不撞号（R7-m6）
const resumeInFlight = new Map(); // zsid → 单飞 promise：并发 load/resume 同一 zsid 只 spawn 一次（R7-B1）
const pendingClose = new Set();   // close 到达时 load/resume 在飞：完成后不入册直接收尸（R7-m4）

// 全局并发闸：zcode 子进程 ~300MB，宿主重连风暴/bug 循环失控 spawn 会直接 OOM 整机
function acquireSpawnSlot() {
  if (spawningCount >= MAX_CONCURRENT_SPAWNS) {
    const err = new Error(`too many concurrent zcode spawns (${spawningCount}/${MAX_CONCURRENT_SPAWNS})`);
    err.code = -32603;
    throw err;
  }
  spawningCount++;
}
function releaseSpawnSlot() { spawningCount = Math.max(0, spawningCount - 1); }

function assertCwd(cwd) {
  let st;
  try { st = statSync(cwd); } catch { st = null; }
  if (!st || !st.isDirectory()) {
    const err = new Error(`cwd is not an accessible directory: ${cwd}`);
    err.code = -32602;
    throw err;
  }
}

function workspaceKeyOf(cwd) {
  // zcode 侧把 key 当不透明 slug（同款即可定位）。逐段编码并把 '-' 转义，防 /a/b 与 /a-b 碰撞；
  // 普通路径（/tmp → -tmp）与真实 zcode 自己生成的 slug 形态一致。
  // R8-m1 定级：真机实测 zcode resume 不校验 key 与创建时一致（v0.1 key 建 / v0.3 key resume /
  // 不带 workspace 均成功）——v0.1→v0.3 编码分叉无实际影响，无需兼容开关。
  return ('/' + cwd).split('/').map(seg => encodeURIComponent(seg).replace(/-/g, '%2D')).join('-');
}

// ---------- zcode 配置层模型清单（provider_config.json） ----------
// $BRIDGE_ZCODE_HOME(缺省进程 HOME)/.zcode/v2/provider_config.json
// 形状：{ schemaVersion, config: { providerOrder: [pid...], providerConfigRules: { providerRules:
//        [{ providerId, providerName?, config: { personalModelIds?: [mid...], builtinModelIds?: [mid...],
//           modelOrder?: [mid...] } }] } } }
// 只取模型 id 清单，绝不读/外发 apiKey。mtime 缓存避免每会话重读。
let cfgCache = { path: null, mtime: 0, data: null };
function readZcodeProviderConfig() {
  const home = ZCODE_HOME || process.env.HOME || '';
  if (!home) return null;
  const path = join(home, '.zcode', 'v2', 'provider_config.json');
  try {
    if (!existsSync(path)) return null;
    const mtime = statSync(path).mtimeMs;
    if (cfgCache.path === path && cfgCache.mtime === mtime && cfgCache.data) return cfgCache.data;
    const raw = JSON.parse(readFileSync(path, 'utf8'));
    const cfg = raw?.config || {};
    const rules = cfg?.providerConfigRules?.providerRules;
    if (!Array.isArray(rules)) return null;
    const providerOrder = Array.isArray(cfg.providerOrder) ? cfg.providerOrder : [];
    const providers = new Map(); // pid -> { label, order, models: [mid...] }
    for (const rule of rules) {
      const pid = rule?.providerId;
      if (!pid || typeof pid !== 'string') continue;
      const c = rule.config || {};
      // 对齐 zcode resolveOwnedOrder 全序语义：[未列入 order 的 builtin] + [order 命中项] + [未列入 order 的 personal]
      const order = Array.isArray(c.modelOrder) ? c.modelOrder.filter(x => typeof x === 'string' && x) : [];
      const personal = Array.isArray(c.personalModelIds) ? c.personalModelIds.filter(x => typeof x === 'string' && x) : [];
      const builtin = Array.isArray(c.builtinModelIds) ? c.builtinModelIds.filter(x => typeof x === 'string' && x) : [];
      const owned = new Set([...personal, ...builtin]);
      const ordered = [];
      const push = (mid) => { if (mid && !ordered.includes(mid)) ordered.push(mid); };
      for (const mid of builtin) if (!order.includes(mid)) push(mid);
      for (const mid of order) if (owned.has(mid)) push(mid);
      for (const mid of personal) if (!order.includes(mid)) push(mid);
      providers.set(pid, { label: typeof rule.providerName === 'string' ? rule.providerName : pid, order: providerOrder.indexOf(pid), models: ordered });
    }
    const data = { providerOrder, providers };
    cfgCache = { path, mtime, data };
    return data;
  } catch (e) {
    log('provider_config.json read failed (config layer disabled)', String(e).slice(0, 200));
    return null;
  }
}

// 配置层模型（按 providerOrder → modelOrder → 其余 排序，截 top:N）
function configLayerModels() {
  if (CONFIG_MODELS_EFF.mode === 'off') return [];
  const cfg = readZcodeProviderConfig();
  if (!cfg) return [];
  const out = [];
  const pids = [...cfg.providers.keys()].sort((a, b) => {
    const oa = cfg.providers.get(a).order, ob = cfg.providers.get(b).order;
    return (oa < 0 ? 1e9 : oa) - (ob < 0 ? 1e9 : ob);
  });
  for (const pid of pids) {
    const p = cfg.providers.get(pid);
    for (const mid of p.models) {
      if (CONFIG_MODELS_EFF.mode === 'top' && out.length >= CONFIG_MODELS_EFF.limit) return out;
      out.push({ providerId: pid, modelId: mid, providerLabel: p.label });
    }
  }
  return out;
}

// ---------- 权限交互（v0.4：请求直答 + 止损归属） ----------
// zcode 3.14+ 的权限是双向竞速：interaction/requestPermission 请求应答 vs v4 resolveInteraction
// 命令，先到先得、晚到 noop（zcode.cjs resolveInteraction "proto.alreadyResolved"）。桥此前对
// 反向请求一律 -32601——错误应答会让交互立即判 failed（真机实测 permission.resolved
// decision=deny），事件侧 resolveInteraction 永远赶不上。现在直接应答请求。
// 请求 result 契约 = zcodePermissionResponseSchema { decision: allow|deny|escalate|modify, ... }；
// 每个选项自带 response 字段，选中的选项直接回它的 response（无则合成 allow/deny）。
function answerPermissionRequest(child, m) {
  const p = m.params || {};
  const s = [...sessions.values()].find(x => x.zc && x.zc.child === child && x.zsid === p.sessionId);
  const reply = (result) => { try { child.stdin.write(JSON.stringify({ id: m.id, result }) + '\n'); } catch {} };
  if (!s) { reply({ decision: 'deny', reason: 'bridge: unknown session' }); return; }
  const optTxt = (o) => String(o?.kind || o?.optionId || o?.name || '');
  const optMeta = () => ({ toolName: p.toolName, riskLevel: p.riskLevel, options: (p.options || []).map(o => o.optionId || o.kind) }); // 只记元数据，不落 input/reason 正文
  const noNeg = (o) => !/^(dis|never|not)[-_ ]/i.test(optTxt(o));
  let opt;
  if (PERM_MODE === 'allow') {
    opt = (p.options || []).find(o => o.kind === 'allow_once')
      || (p.options || []).find(o => o.kind === 'allow_session')
      || (p.options || []).find(o => /allow|approve|accept|proceed/i.test(optTxt(o)) && !/always|remember|persist/i.test(optTxt(o)) && noNeg(o))
      || (p.options || []).find(o => /allow|approve|accept|proceed/i.test(optTxt(o)) && noNeg(o));
    if (opt && /always|remember|persist/i.test(optTxt(opt))) {
      log('allow fallback hit a persistent option (word list drift?)', optMeta()); // 自动批准不该替用户留下永久授权，留痕
    }
  } else {
    opt = (p.options || []).find(o => o.kind === 'deny')
      || (p.options || []).find(o => /deny|reject/i.test(optTxt(o)) && !/^(un|not|never)[-_ ]/i.test(optTxt(o)));
  }
  if (opt) { reply(opt.response || { decision: PERM_MODE === 'allow' ? 'allow' : 'deny' }); return; }
  // 无匹配选项：应答 deny 解掉这个交互本身（悬着只会等超时），会话级动作交止损归属判定
  log(PERM_MODE === 'allow' ? 'allow mode: no approvable option' : 'deny mode: no matching option', optMeta());
  reply({ decision: 'deny', reason: 'no bridge-approved option' });
  permissionStopLoss(s, p, PERM_MODE === 'allow' ? 'permission stuck' : 'denied by policy');
}

// 止损归属判定（事件路径与请求路径共用）。payload 无 inputId（3.14.3 实测），用
// toolCallId ∈ seenToolCalls 作证——工具卡事件先于权限请求到达（真机实测）。
// 外来轮（僵尸轮补发的权限）：只记日志不动会话——session/stop 是会话级（会误杀健康在飞轮）、
// endTurn 会把当前 waiter 误标 refusal（R7-M2）。
function permissionStopLoss(s, p, why) {
  const foreign = p.toolCallId && s.seenToolCalls.size > 0 && !s.seenToolCalls.has(p.toolCallId);
  if (foreign) { log('permission stop-loss skipped (foreign/zombie turn)', why); return; }
  if (!s.turnWaiter && !s.pendingTurnOp) { log('permission stop-loss skipped (no in-flight op)', why); return; }
  log('permission stop-loss', why);
  s.zc?.request('session/stop', { sessionId: s.zsid }, 10000).catch(() => {});
  if (s.compaction && s.compaction.inProgressSent) emitCompactionCard(s, 'failed', why); // 抢跑卡防护（R7-n5）
  endTurn(s, 'refusal');
}

// -32010（prompt already running / cannot compact while running）短退避重试：紧邻 cancel/
// 看门狗收口后立刻重发时，上一轮的终结往往数百 ms 内落定（R7-M3）。cancel 已到（用户要的就是停）
// 或 waiter 已被收（同 chunk 竞态/看门狗）就不重试；非 -32010 错误原样抛出。
async function requestTurnOpWithRetry(zc, s, method, params, timeoutMs) {
  let lastErr = null;
  for (let attempt = 1; attempt <= 3; attempt++) {
    try {
      return await zc.request(method, params, timeoutMs);
    } catch (e) {
      lastErr = e;
      if (e?.zcodeCode !== -32010 || attempt >= 3 || s.cancelRequested || !s.turnWaiter) break;
      log('turn op rejected -32010, retrying', method, { attempt });
      await new Promise(r => setTimeout(r, 400 * attempt));
    }
  }
  throw lastErr;
}

// ---------- zcode 子进程管理 ----------
function spawnZcode(cwd) {
  const env = { ...process.env };
  if (ZCODE_HOME) env.HOME = ZCODE_HOME;
  const child = spawn(ZCODE_BIN, ['app-server', '--stdio'], { cwd, env, stdio: ['pipe', 'pipe', 'pipe'] });
  allChildren.add(child);
  let buf = '';
  let zid = 0;
  const pending = new Map();
  child.stdout.on('data', (d) => {
    buf += d.toString();
    let i;
    while ((i = buf.indexOf('\n')) >= 0) {
      const line = buf.slice(0, i); buf = buf.slice(i + 1);
      if (!line.trim()) continue;
      let m; try { m = JSON.parse(line); } catch { continue; }
      if (m.id !== undefined && m.method) {
        // 反向请求：runtime 偏好必须应答，否则 session/create 挂起；权限请求必须应答，
        // 否则交互被判 failed（-32601 错误应答也会立即判 failed——见 answerPermissionRequest）
        if (m.method === 'session/requestRuntimePreferences') {
          child.stdin.write(JSON.stringify({ id: m.id, result: { nativeSearchEnhancementsEnabled: false } }) + '\n');
        } else if (m.method === 'interaction/requestPermission') {
          answerPermissionRequest(child, m);
        } else {
          log('zcode reverse request (declining)', m.method);
          child.stdin.write(JSON.stringify({ id: m.id, error: { code: -32601, message: 'Method not supported by bridge' } }) + '\n');
        }
        continue;
      }
      if (m.id !== undefined && pending.has(m.id)) { pending.get(m.id)(m); pending.delete(m.id); continue; }
      if (m.method) handleZcodeNotification(m);
    }
    // 无换行的超长倾倒（对端失控/协议错乱）：整段丢弃，防 buf 无界增长吃光内存
    if (buf.length > LINE_BUF_MAX) { log('zcode stdout buffer overflow, dropping', { bytes: buf.length }); buf = ''; }
  });
  child.stderr.on('data', (d) => log('zcode stderr:', String(d).trim().slice(0, 500)));
  // 子进程死了/起不来：在飞请求立刻报错返回，别等各自超时
  const failPending = (message) => {
    for (const [id, p] of pending) { p({ error: { code: -1, message } }); pending.delete(id); }
  };
  // spawn 失败（ENOENT 等）只触发 error 不触发 exit：同样要收尸，防 allChildren 泄漏
  child.on('error', (e) => { log('zcode child error', String(e)); allChildren.delete(child); failPending(`zcode child error: ${e.message}`); });
  child.on('exit', (code, sig) => {
    log('zcode child exit', { code, sig });
    allChildren.delete(child);
    failPending(`zcode child exited (${code}/${sig})`);
    const s = [...sessions.values()].find(x => x.zc && x.zc.child === child);
    if (s) {
      s.zc = null; // 子进程没了：保留会话条目，下次 prompt 走 resume 重建
      if (s.turnWaiter) {
        notifySessionUpdate(s.zsid, { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: '[zcode 进程退出，本轮终止]' } });
        if (s.compaction) emitCompactionCard(s, 'failed', 'zcode 进程退出，压缩终止');
        endTurn(s, 'end_turn');
      }
    }
  });
  return {
    child,
    request(method, params, timeoutMs = 30000) {
      return new Promise((resolve, reject) => {
        const id = ++zid;
        const timer = setTimeout(() => { pending.delete(id); reject(new Error(`zcode timeout: ${method}`)); }, timeoutMs);
        pending.set(id, (m) => {
          clearTimeout(timer);
          // zcode 错误响应（{id, error:{code,message}}）走 reject，调用方 catch 统一处理
          if (m.error) {
            const err = new Error(m.error.message || `zcode error: ${method}`);
            err.zcodeCode = m.error.code;
            reject(err);
            return;
          }
          resolve(m);
        });
        child.stdin.write(JSON.stringify({ id, method, params }) + '\n');
      });
    },
    kill() { try { child.kill('SIGKILL'); } catch {} },
  };
}

// ---------- zcode 事件 → ACP session/update ----------
function notifySessionUpdate(sid, update) {
  acpSend({ method: 'session/update', params: { sessionId: sid, update } });
}

function toolKindOf(toolName) {
  const n = (toolName || '').toLowerCase();
  if (/(^|_)(read|view|glob|grep|search|ls|list)/.test(n)) return 'read';
  if (/(edit|write|patch|apply|create|save)/.test(n)) return 'edit';
  if (/(bash|exec|run|command|terminal|shell)/.test(n)) return 'execute';
  if (/(fetch|web|http|browser)/.test(n)) return 'fetch';
  if (/(think|plan|todo)/.test(n)) return 'think';
  return 'other';
}

// compaction_update 卡片（status ∈ in_progress|completed|failed；不用 cancelled——codeg 前端
// 工具状态联合类型里没有它）。_meta.contextCompaction 富字段全部可选，缺省 codeg 自补 {version:1}。
// 摘要文本走顶层 summary: [ContentBlock]（codeg connection.rs 只从顶层取），_meta 里留一份冗余无害。
function emitCompactionCard(s, status, error, extraMeta) {
  if (!s.compaction) return;
  const meta = { contextCompaction: { version: 1, trigger: 'manual', ...(extraMeta || {}) } };
  const upd = { sessionUpdate: 'compaction_update', compactionId: s.compaction.id, status };
  if (error) upd.error = error;
  if (status === 'completed' && s.compaction.summary) upd.summary = [{ type: 'text', text: s.compaction.summary }];
  upd._meta = meta;
  if (status === 'in_progress') s.compaction.inProgressSent = true;
  notifySessionUpdate(s.zsid, upd);
  log('compaction card', status, s.compaction.id, error || '');
}

function handleZcodeNotification(m) {
  const method = m.method;
  if (method !== 'session/event' && method !== 'state.updated') return; // 遥测/存储等一律忽略
  const sid = m.params?.sessionId;
  if (!sid) return;
  const s = sessions.get(sid);
  if (!s) return;

  if (method === 'state.updated') {
    // 投影补丁：status 等。v1 不透传（MindFS 不消费）；仅记录。不算活跃（文件监听等噪声会饿死回收器）
    return;
  }
  const ev = m.params; // {type, payload, seq, eventId, deliveryKind}
  const type = ev.type;
  const p = ev.payload || {};
  // 活跃度按归属计：带 inputId 但无主（外来/未知代际——僵尸轮残留）的事件不刷新计时，
  // 防僵尸轮事件流饿死闲置回收器（R7-m5）。不带 inputId（旧 zcode/中间事件）照常计。
  if (typeof p.inputId === 'string' && p.inputId !== s.activeInputId && !(s.foreignInputIds && s.foreignInputIds.has(p.inputId))) {
    // 处理照旧（终结归属判定在 handleTurnEnd），只是不计活跃
  } else {
    s.lastActivity = Date.now();
  }
  // 高频流式 delta 不逐条落盘（一轮数千条，长跑 GB 级）；其余事件照常
  // 事件元数据概要：只留 id/计数类字段，绝不落正文（模型输出/工具输入可能含敏感内容）
  if (type !== 'part.delta' && type !== 'model.streaming') {
    const brief = {
      turnNumber: p.turnNumber, toolCallId: p.toolCallId, toolName: p.toolName, kind: p.kind,
      messageId: p.messageId, partId: p.partId, riskLevel: p.riskLevel, requestId: p.requestId,
      tokens: p.tokenCount ?? p.usage?.outputTokens, duration: p.duration,
      responseBytes: p.response !== undefined ? String(p.response).length : undefined,
      errorType: p.error?.type, keys: Object.keys(p).slice(0, 12),
    };
    log('event', type, JSON.stringify(brief));
  }

  switch (type) {
    case 'session.titleUpdated':
      // MindFS 用会话 key 管理标题，标题变化不透传（无对应 ACP 通知）
      break;

    case 'turn.started': {
      s.fullTextLen = 0; // 新一轮：全文增量追踪归零
      // 归属证据（zcode 3.14+ 事件回显 inputId）：精确匹配才作证，异源 started 不污染。
      // 兜底（事件不带 inputId 的旧 zcode）：沿用"waiter/pendingTurnOp 在飞即作证"启发式。
      if (p.inputId) {
        if (s.activeInputId && p.inputId === s.activeInputId) s.sawTurnStarted = true;
      } else if (s.turnWaiter || s.pendingTurnOp) {
        s.sawTurnStarted = true;
      }
      break;
    }

    case 'part.delta': {
      // 中间事件归属过滤（R7-M4）：3.14.3 实测中间事件不带 inputId（不过滤）；
      // 带且无主 → 僵尸流，丢弃防污染 UI。终结事件归属在 handleTurnEnd，不走这里
      if (!knownInput(s, p.inputId)) { log('intermediate event with unknown inputId dropped', type); break; }
      const text = p.delta || '';
      if (!text) break;
      if (p.field === 'reasoning') {
        s.sawText = true;
        notifySessionUpdate(sid, { sessionUpdate: 'agent_thought_chunk', content: { type: 'text', text } });
      } else if (p.field === 'text' || p.field === undefined) {
        s.sawText = true;
        s.fullTextLen += text.length; // 与 message.upserted 兜底共享同一增量水位
        notifySessionUpdate(sid, { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text } });
      }
      // field input/output 是工具流的内部增量，v1 不透传（tool.updated 已带全量）
      break;
    }

    // 3.14.x 词表兜底：整条消息 upsert（payload {content,...}）。只补发相对本轮已发前缀的增量，
    // 与 part.delta 共用水位——两套词表谁在流式都不重复、都不缺。
    case 'message.upserted': {
      if (!knownInput(s, p.inputId)) { log('intermediate event with unknown inputId dropped', type); break; }
      const text = typeof p.content === 'string' ? p.content : '';
      if (text.length > (s.fullTextLen || 0)) {
        const suffix = text.slice(s.fullTextLen || 0);
        s.sawText = true;
        s.fullTextLen = text.length;
        notifySessionUpdate(sid, { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: suffix } });
      }
      break;
    }

    // 词表 B（zcode CLI 0.16.x 实测）：文本/工具输入流都走 model.streaming
    case 'model.streaming': {
      if (!knownInput(s, p.inputId)) { log('intermediate event with unknown inputId dropped', type); break; }
      const kind = p.kind || 'text_delta';
      if ((kind === 'text_delta' || kind === 'reasoning_delta') && p.delta) {
        s.sawText = true;
        if (kind === 'text_delta') s.fullTextLen += p.delta.length; // 与 part.delta/message.upserted 共享水位，防兜底重发
        notifySessionUpdate(sid, kind === 'reasoning_delta'
          ? { sessionUpdate: 'agent_thought_chunk', content: { type: 'text', text: p.delta } }
          : { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: p.delta } });
      }
      break;
    }

    case 'session.updated': {
      // zcode 3.14+ 的压缩事件走这条（而非 part.upserted）：载荷带 operationId/status 的
      // 操作事件 + 带 boundaryId 的边界事件（pre/postCompactTokenCount）。
      // 只补 compaction 卡的 token 元数据——生命周期卡仍由 turn.completed 驱动（统一时序）
      if (s.compaction && Number.isFinite(p.preCompactTokenCount)) {
        s.compaction.pre = p.preCompactTokenCount;
        if (Number.isFinite(p.postCompactTokenCount)) s.compaction.post = p.postCompactTokenCount;
      }
      break;
    }

    case 'part.upserted': {
      if (!knownInput(s, p.inputId)) { log('intermediate event with unknown inputId dropped', type); break; }
      const part = p.part || {};
      if (part.type === 'tool') {
        emitToolPart(sid, s, part);
      } else if (part.type === 'compaction') {
        // 压缩 turn 的产物 part：能捞到多少富字段捞多少（防御式，字段名以实测为准）
        if (s.compaction) {
          if (Number.isFinite(part.preTokens)) s.compaction.pre = part.preTokens;
          if (Number.isFinite(part.postTokens)) s.compaction.post = part.postTokens;
          if (typeof part.summary === 'string' && part.summary) s.compaction.summary = part.summary;
        }
      }
      // text/reasoning 的整段 upsert：若该 part 已流过 delta 则忽略；否则作为一次 chunk 补发
      else if (part.type === 'text' || part.type === 'reasoning') {
        const key = `${part.messageId}/${part.partId}`;
        if (!s.partStarted.has(key)) {
          s.partStarted.add(key);
          const text = part.text || '';
          if (text) {
            notifySessionUpdate(sid, part.type === 'reasoning'
              ? { sessionUpdate: 'agent_thought_chunk', content: { type: 'text', text } }
              : { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text } });
          }
        }
      }
      break;
    }

    case 'tool.updated':
      if (!knownInput(s, p.inputId)) { log('intermediate event with unknown inputId dropped', type); break; }
      emitToolUpdated(sid, s, p);
      break;

    case 'permission.requested': {
      // 未来 zcode 给中间事件/权限事件补 inputId 时的防护：无主（僵尸轮）权限事件不代答
      if (!knownInput(s, p.inputId)) { log('permission event with unknown inputId dropped', { toolName: p.toolName, riskLevel: p.riskLevel }); break; }
      // 事件侧处理在 v0.4 降级为兜底：真机 zcode 3.14+ 的主通道是 interaction/requestPermission
      // 请求直答（answerPermissionRequest，先到先得）；本路径只在宿主不发请求的版本/测试 mock 生效。
      // requestId 按 schema 可选，缺失回退 toolCallId（与 zcode 实现层同款兜底，R8-m3）。
      const interactionId = p.requestId || p.toolCallId;
      // allow 档：yolo 生效时不应出现；出现（版本差异 yolo 不可用）则尽力自动批准，救不动就止损收口。
      // 匹配优先 kind 白名单（zcode 约定 allow_once/allow_session/allow_always），词表只兜底且排除否定
      // 语义（disallow/never approve 这类未来词条不能被 /allow|approve/ 误匹配成"批准"）。
      const optTxt = (o) => String(o?.kind || o?.optionId || o?.name || '');
      const optMeta = (p) => ({ toolName: p.toolName, riskLevel: p.riskLevel, options: (p.options || []).map(o => o.optionId || o.kind) }); // 只记元数据，不落 input/reason 正文
      if (PERM_MODE === 'allow' && interactionId) {
        const opts = p.options || [];
        const noNeg = (o) => !/^(dis|never|not)[-_ ]/i.test(optTxt(o));
        const allowOpt = opts.find(o => o.kind === 'allow_once')
          || opts.find(o => o.kind === 'allow_session')
          || opts.find(o => /allow|approve|accept|proceed/i.test(optTxt(o)) && !/always|remember|persist/i.test(optTxt(o)) && noNeg(o))
          || opts.find(o => /allow|approve|accept|proceed/i.test(optTxt(o)) && noNeg(o));
        if (allowOpt && /always|remember|persist/i.test(optTxt(allowOpt))) {
          log('allow fallback hit a persistent option (word list drift?)', optMeta(p)); // 自动批准不该替用户留下永久授权，留痕
        }
        if (allowOpt?.optionId && s.zc) {
          s.zc.request('v4/command', {
            sessionId: sid,
            type: 'resolveInteraction',
            payload: { resolveInteraction: { interactionId, answer: { optionId: allowOpt.optionId } } },
          }).catch(e => log('allow resolveInteraction failed', String(e).slice(0, 150)));
        } else {
          // 不发猜测的 optionId：止损收口（归属判定在 permissionStopLoss 内）
          permissionStopLoss(s, p, 'permission stuck');
        }
      } else if (PERM_MODE === 'deny' && interactionId) {
        const opts = p.options || [];
        const denyOpt = opts.find(o => o.kind === 'deny')
          || opts.find(o => /deny|reject/i.test(optTxt(o)) && !/^(un|not|never)[-_ ]/i.test(optTxt(o)));
        if (denyOpt?.optionId && s.zc) {
          s.zc.request('v4/command', {
            sessionId: sid,
            type: 'resolveInteraction',
            payload: { resolveInteraction: { interactionId, answer: { optionId: denyOpt.optionId } } },
          }).catch(e => log('deny resolveInteraction failed', String(e).slice(0, 150)));
        } else {
          permissionStopLoss(s, p, 'denied by policy');
        }
      } else {
        log('permission.requested unexpected', optMeta(p));
      }
      break;
    }

    case 'turn.completed':
    case 'turn.failed':
      handleTurnEnd(s, sid, type, p);
      break;

    default:
      break;
  }
}

// 事件归属过滤器（中间事件用）：inputId 缺省（旧 zcode/现版中间事件）→ 放行；
// 等于本轮在飞 op 的 inputId 或命中 foreign 追踪（cancel/看门狗收掉的在飞轮，含 already_running
// 跟随的目标轮）→ 放行；其余 → 无主（僵尸流）→ 调用方丢弃。
function knownInput(s, id) {
  if (typeof id !== 'string') return true;
  if (id === s.activeInputId) return true;
  if (s.foreignInputIds && s.foreignInputIds.has(id)) return true;
  return false;
}

// turn 终结统一收口。归属判定两级：
//   精确（zcode 3.14+：send/compact 的 inputId 会被 turn 事件回显）——
//     匹配 activeInputId → 本轮终结（pendingTurnOp 期间缓存，响应回来重放）；
//     命中 foreignInputIds → 此前发起、未见到终结的轮（cancel/看门狗/退出后仍可能在飞）。
//       已在飞等待（already_running 跟随）时直接用它收口；请求窗口内先缓存。
//     其余 inputId → 无主事件：吞。
//   兜底（旧 zcode 事件不带 inputId）——原三重身份判定：
//     1. 无 waiter + 非 pendingTurnOp → 迟到事件：吞。
//     2. 有 waiter 但没见过本轮 turn.started → 旧轮补发的终结：吞。
//     3. 无 waiter + pendingTurnOp → waiter 尚未挂上：缓存终结，响应处理后立即重放。
function handleTurnEnd(s, sid, type, p) {
  const kind = type === 'turn.failed' ? 'failed' : 'completed';
  if (p && typeof p.inputId === 'string') {
    if (p.inputId === s.activeInputId) {
      if (s.pendingTurnOp) {
        s.bufferedTurnEnd = { kind, p };
        log('turn end buffered (same-chunk, response in flight)', kind, p.inputId);
      } else if (s.turnWaiter) {
        finishTurn(s, sid, kind, p);
      } else {
        log('turn end for already-finished op ignored', kind, p.inputId);
      }
      return;
    }
    if (s.foreignInputIds && s.foreignInputIds.has(p.inputId)) {
      s.foreignInputIds.delete(p.inputId);
      if (s.pendingTurnOp) {
        s.bufferedForeignEnd = { kind, p };
        log('foreign turn end buffered (response in flight)', kind, p.inputId);
      } else if (s.turnWaiter && s.followForeign) {
        // already_running 跟随：在飞压缩（我们早前发起）此刻终结——用它收口当前 prompt。
        // followForeign 门控：不带门的 foreign 收口会让无关僵尸轮（如 cancel 后迟到的
        // 旧 prompt 终结）误收新一轮的 waiter
        log('foreign turn end finishing follower turn', kind, p.inputId);
        finishTurn(s, sid, kind, p);
      } else {
        log('foreign turn end ignored (no waiter / not following)', kind, p.inputId);
      }
      return;
    }
    log('turn end with unknown inputId ignored', kind, p.inputId);
    return;
  }
  if (!s.turnWaiter) {
    if (s.pendingTurnOp && s.sawTurnStarted) {
      s.bufferedTurnEnd = { kind, p };
      log('turn end buffered (same-chunk, waiter not mounted yet)', kind);
    } else if (s.pendingTurnOp) {
      // R7-M1：请求窗口内、无 inputId、且本轮 turn.started 未见过——本轮终结不可能先于本轮
      // started，只能是上一轮（僵尸/在飞压缩轮）的终结。旧 zcode 无 inputId 无法精确归属，
      // 缓存为 foreign 候选：already_running 跟随时重放收口；accepted 时随收口作废（外来终结本该吞）
      s.bufferedForeignEnd = { kind, p };
      log('legacy foreign turn end buffered (pendingTurnOp, no attestation)', kind);
    } else {
      log('stale turn end ignored (no waiter)', kind);
    }
    return;
  }
  if (!s.sawTurnStarted) {
    // 有 waiter 但代际证据未见 + 请求窗口内：同上只能是旧轮终结，缓存供 already_running 重放
    if (s.pendingTurnOp) {
      s.bufferedForeignEnd = { kind, p };
      log('legacy foreign turn end buffered (waiter, no attestation)', kind);
    } else {
      log('stale turn end ignored (no turn.started for current waiter)', kind);
    }
    return;
  }
  finishTurn(s, sid, kind, p);
}

function finishTurn(s, sid, kind, p) {
  s.activeInputId = null; // 本轮终结已被见到：不进 foreign 追踪（endTurn 只收"未见终结"的 inputId）
  if (kind === 'failed') {
    const errMsg = p.error?.message || p.error?.detail || 'turn failed';
    if (s.compaction) {
      emitCompactionCard(s, 'failed', errMsg);
    } else {
      notifySessionUpdate(sid, { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: `[zcode turn failed] ${errMsg}` } });
    }
    s.sawText = false; s.fullTextLen = 0; // failed 分支同样归零水位，防下一轮兜底重放旧前缀（R7-n2）
    endTurn(s, 'end_turn');
    return;
  }
  // 保险：万一 delta 流没接住（词表差异/订阅晚到），0.16.x 的 payload.response 是全量文本
  if (!s.sawText && p.response) {
    notifySessionUpdate(sid, { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: String(p.response) } });
  }
  s.sawText = false;
  s.fullTextLen = 0;
  if (s.compaction) {
    const meta = {};
    if (Number.isFinite(s.compaction.pre)) meta.preTokens = s.compaction.pre;
    if (Number.isFinite(s.compaction.post)) meta.postTokens = s.compaction.post;
    if (Number.isFinite(p.duration)) meta.durationMs = p.duration;
    if (s.compaction.summary) meta.summary = s.compaction.summary;
    emitCompactionCard(s, 'completed', undefined, meta);
  }
  endTurn(s, 'end_turn');
}

function endTurn(s, stopReason) {
  // 收口时本轮终结事件未见（cancel/看门狗/进程退出/错误清理）：zcode 侧 turn 可能仍在飞
  //（stop 是异步的）——inputId 转 foreign 追踪，其迟到终结供 already_running 跟随收口。
  // 上限 8 个 FIFO：只关心最近的在飞轮，更老的终结事件本就该吞。
  if (s.activeInputId) {
    s.foreignInputIds.add(s.activeInputId);
    while (s.foreignInputIds.size > 8) s.foreignInputIds.delete(s.foreignInputIds.values().next().value);
    s.activeInputId = null;
  }
  s.bufferedForeignEnd = null; // 收口即过代：foreign 缓存随本轮作废
  s.followForeign = false;     // 同理：跟随态不跨轮
  if (!s.turnWaiter) return;
  s.lastStopReason = stopReason;
  s.sawTurnStarted = false;   // 收口后代际证据作废：旧轮迟到的 started 不该替新轮作证
  s.bufferedTurnEnd = null;   // 同理清缓存，防旧轮缓存重放到新轮
  s.seenToolCalls.clear();    // 工具卡不跨轮存活：防长会话无界增长 + 旧 id 吞掉迟到的 update
  s.partStarted.clear();
  if (s.turnWaiter.timer) clearTimeout(s.turnWaiter.timer);
  const w = s.turnWaiter; s.turnWaiter = null;
  w.resolve({ stopReason });
}

function emitToolPart(sid, s, part) {
  // part.type=tool：state.status pending/running/completed/error
  const st = part.state || {};
  const toolCallId = part.toolCallId || part.partId;
  const status = st.status;
  const acpStatus = status === 'pending' ? 'pending' : status === 'running' ? 'in_progress'
    : status === 'error' ? 'failed' : 'completed';
  const raw = {
    toolCallId, toolName: part.toolName || 'tool',
    state: st, title: st.title || part.toolName || 'tool',
  };
  emitToolCommon(sid, s, raw, acpStatus);
}

function emitToolUpdated(sid, s, base) {
  // 0.16.x 形状：kind=batch 是批量汇总（toolCallIds 复数），单卡已由各 result 事件宣告，跳过
  if (base.kind === 'batch' && Array.isArray(base.toolCallIds)) return;
  // 0.16.x 形状：无 kind 但带 result → 工具完成（result.content = 输出文本）
  if (base.kind === undefined && base.result !== undefined) {
    const out = base.result?.content !== undefined ? base.result.content : base.result;
    return emitToolCommon(sid, s, { ...base, output: out }, base.result?.success === false ? 'failed' : 'completed');
  }
  // tool.updated payload = 基座字段 + state 变体之一（kind: scheduled/started/progress/result/error/...）
  const kind = base.kind || base.state?.kind;
  const acpStatus = kind === 'scheduled' ? 'pending'
    : (kind === 'started' || kind === 'progress') ? 'in_progress'
    : kind === 'error' ? 'failed'
    : (kind === 'result' || kind === 'batch' || kind === 'raw') ? 'completed'
    : base.dependencies !== undefined ? 'pending' // 0.16.x：无 kind + dependencies → 计划中
    : 'in_progress';
  emitToolCommon(sid, s, base, acpStatus);
}

function emitToolCommon(sid, s, t, acpStatus) {
  const toolCallId = t.toolCallId;
  if (!toolCallId) return;
  // 0.16.x 的 result 事件可能不带 toolName/title → 沿用首宣告的标题（Map: id -> title）
  let firstTitle = s.seenToolCalls.get?.(toolCallId);
  if (typeof firstTitle !== 'string') firstTitle = undefined;
  const title = (t.title && t.title !== 'tool') ? t.title
    : (t.toolName && t.toolName !== 'tool') ? t.toolName
    : (firstTitle || t.title || t.toolName || 'tool');
  const kind = toolKindOf(t.toolName);
  const rawInput = t.state?.input !== undefined ? t.state.input : t.input;
  const output = t.state?.output !== undefined ? t.state.output
    : (t.state?.status === 'error' ? t.state.error : t.output);
  const upd = { sessionUpdate: 'tool_call', toolCallId, title, kind, status: acpStatus };
  if (rawInput !== undefined) upd.rawInput = rawInput;
  if (output !== undefined && output !== null && String(output).length) {
    upd.content = [{ type: 'content', content: { type: 'text', text: String(output).slice(0, 20000) } }];
  }
  if (s.seenToolCalls.has(toolCallId)) {
    // 已宣告过 → 只发变化字段
    const u2 = { sessionUpdate: 'tool_call_update', toolCallId, status: acpStatus, title };
    if (upd.content) u2.content = upd.content;
    notifySessionUpdate(sid, u2);
  } else {
    s.seenToolCalls.set(toolCallId, title);
    notifySessionUpdate(sid, upd);
  }
}

// ---------- 会话建立 ----------
async function createZcodeSession(cwd) {
  const zc = spawnZcode(cwd);
  try {
    return await initZcodeSession(zc, cwd);
  } catch (e) { zc.kill(); throw e; } // 握手任何一步失败/超时都杀子进程，防 ~300MB 泄漏
}

// session/read 的 settings → 会话态（模型/思考深度实时层）
function absorbSessionSettings(s, rd) {
  const settings = rd?.result?.settings || rd?.result?.state?.settings;
  if (!settings) return;
  const avail = settings?.model?.available || [];
  s.providerId = settings?.model?.current?.providerId
    || avail.find(mo => mo.ref?.providerId)?.ref?.providerId
    || s.providerId;
  s.liveModels = avail.map(mo => ({
    ref: mo.ref,
    label: mo.label || mo.ref?.modelId || mo.ref?.providerId || 'model',
    providerLabel: mo.providerLabel,
    description: [mo.contextWindow ? `ctx ${mo.contextWindow}` : null, mo.description].filter(Boolean).join('，'),
  }));
  const cur = settings?.model?.current;
  if (cur?.providerId && cur?.modelId) {
    s.currentModelId = `${cur.providerId}${SEP}${cur.modelId}` + (cur.options?.reasoningLevel ? `${SEP}${cur.options.reasoningLevel}` : '');
  }
  const tl = settings?.thoughtLevel;
  if (tl && tl.enabled && Array.isArray(tl.available) && tl.available.length) {
    s.thoughtLevels = {
      current: typeof tl.current === 'string' ? tl.current : (tl.available.find(a => a.value === tl.defaultLevel)?.value || tl.available[0]?.value),
      available: tl.available.map(a => ({ value: String(a.value ?? a), label: String(a.label ?? a.value ?? a) })),
    };
  } else if (tl && tl.enabled === false) {
    s.thoughtLevels = null;
  }
  if (settings?.mode?.current) s.currentMode = settings.mode.current;
}

// spawn 之后的握手/清单/默认模型/订阅（由 createZcodeSession 包 try/catch 调用）
async function initZcodeSession(zc, cwd) {
  const workspaceKey = workspaceKeyOf(cwd);
  const cr = await zc.request('session/create', { workspace: { workspacePath: cwd, workspaceKey } }, 45000); // 错误响应走 reject
  const zsid = cr.result?.session?.sessionId;
  if (!zsid) throw new Error('session/create returned no sessionId');
  log('zcode session created', zsid, 'pid', zc.child.pid);

  const s = newSessionState(zc, zsid, cwd, workspaceKey);
  try {
    const rd = await zc.request('session/read', { sessionId: zsid }, 20000);
    absorbSessionSettings(s, rd);
  } catch (e) { log('session/read failed (fallback to env/config layers)', String(e)); }

  if (PERM_MODE === 'allow') {
    try {
      await zc.request('session/setMode', { sessionId: zsid, mode: 'yolo' }, 10000);
      s.currentMode = 'yolo';
    } catch (e) { log('setMode yolo failed', String(e)); }
  }

  // 默认模型：BRIDGE_DEFAULT_MODEL（或清单第一项）。setModel 需带 reasoningLevel（kimi-k3 等强校验）；
  // 未指定级别时先裸切，被拒则回落 low。providerId 推导链：session/read 实测 → 配置层 providerOrder[0]
  // → 兜底 'new-provider'；BRIDGE_DEFAULT_MODEL 支持 provider␟model 显式指定（覆盖推导）。
  if (DEFAULT_MODEL) {
    let explicitProvider;
    let spec = DEFAULT_MODEL;
    if (spec.includes(SEP)) { [explicitProvider, spec] = spec.split(SEP); }
    const at = spec.indexOf('@');
    const mid = at < 0 ? spec : spec.slice(0, at);
    const level = at < 0 ? undefined : spec.slice(at + 1);
    const providerId = explicitProvider || s.providerId || configLayerModels()[0]?.providerId;
    if (providerId) {
      const model = { providerId, modelId: mid };
      if (level) model.options = { reasoningLevel: level };
      try {
        await zc.request('session/setModel', { sessionId: zsid, model }, 15000);
      } catch (e) {
        const msg = String(e?.message || e);
        if (!level && /reasoning/i.test(msg)) {
          try {
            await zc.request('session/setModel', { sessionId: zsid, model: { ...model, options: { reasoningLevel: 'low' } } }, 15000);
          } catch (e2) { log('setModel default(low) failed', String(e2).slice(0, 200)); }
        } else log('setModel default failed', msg.slice(0, 200));
      }
      s.currentModelId = `${providerId}${SEP}${mid}` + (level ? `${SEP}${level}` : '');
      s.providerId = providerId;
    } else {
      log('setModel default skipped: no providerId known (read failed, no config layer)');
    }
  }

  // 订阅失败升级为建立失败：没有事件流 turn.completed 永远不会到，首轮 prompt 必挂看门狗——
  // 宁可让宿主在 session/new|load 时就拿到错误重试，不给用户一个"发消息没反应"的哑会话
  await zc.request('session/subscribe', { sessionId: zsid, deliveryKind: 'desktop-continuous' }, 15000);
  return s;
}

function newSessionState(zc, zsid, cwd, workspaceKey) {
  return {
    zc, zsid, cwd, workspaceKey,
    models: [],            // v0.1 兼容层：session/new|load|resume 响应里的 models 块（旧宿主消费；非 ACP schema 字段，MindFS 私有扩展）
    currentModelId: null,
    currentMode: 'build',
    explicitMode: null,    // 宿主显式设过的模式（set_mode / set_config_option('mode')）；respawn 时优先恢复它而非强切 yolo
    providerId: 'new-provider',
    liveModels: [],        // session/read available 实时层
    thoughtLevels: null,   // { current, available:[{value,label}] } | null
    seenToolCalls: new Map(), partStarted: new Set(), turnWaiter: null,
    sawTurnStarted: false,   // [兜底] 旧 zcode 事件不带 inputId 时的代际证据：本轮 turn.started 是否已见
    pendingTurnOp: false,    // send/compact 已写出但响应未处理（同 chunk 终结缓存判据）
    bufferedTurnEnd: null,   // 同 chunk 场景暂存的终结事件 { kind, p }
    activeInputId: null,     // 当前在飞 turn op 的精确归属 id（session/send|compact 回传，turn 事件回显）
    foreignInputIds: new Set(), // 曾发起但终结事件未见（cancel/看门狗/进程退出）的 inputId：其迟到终结用于 already_running 跟随
    followForeign: false,    // already_running 跟随态：仅此时 foreign 终结才允许收当前 waiter（防无关僵尸轮误收口）
    bufferedForeignEnd: null,   // pendingTurnOp 窗口内到达的 foreign 终结 { kind, p }（already_running 同 chunk 竞态）
    cancelRequested: false,  // ensureZcode 重建窗口内收到 cancel：重建完成后本轮直接收口，不再开跑
    _respawn: null,          // ensureZcode 在飞重建 promise（并发去重）
    compaction: null, compactSeq: 0,
    opQueue: Promise.resolve(), // set_config_option 串行闸
    opDepth: 0,              // 串行闸积压深度（防宿主洪泛 → 小时级排队）
    lastStopReason: 'end_turn',
    sawText: false, lastActivity: Date.now(), busy: false, fullTextLen: 0, closed: false,
  };
}

// 闲置回收：zcode 子进程 ~300MB 常驻太贵；空闲 IDLE_MS 后杀掉，下次 prompt 走 session/resume 秒级重建
const IDLE_MS = parseMsEnv(process.env.BRIDGE_IDLE_EXIT_MS, 10 * 60 * 1000, 60000);
setInterval(() => {
  const now = Date.now();
  for (const s of sessions.values()) {
    if (s.zc && !s.turnWaiter && !s.closed && now - (s.lastActivity || 0) > IDLE_MS) {
      log('idle recycle: killing zcode child', s.zsid, `idle ${Math.round((now - s.lastActivity) / 1000)}s`);
      s.zc.kill(); s.zc = null;
    }
  }
}, 60 * 1000).unref();

// ---------- config option 组装（codeg 模型/思考深度选择器的数据源） ----------
// v1 wire 形状（平铺，不嵌套 kind；分组用 options:[{group,name,options}]）：
//   { id, name, category?, type: 'select', currentValue, options: [...] }
function encModelValue(providerId, modelId) {
  return `${providerId}${SEP}${modelId}`;
}
function decodeModelValue(v) {
  const parts = String(v || '').split(SEP);
  if (parts.length < 2) return null;
  if (parts.length > 3) log('model value has extra SEP segments (injection? truncating)', { segments: parts.length }); // R8-n4：留痕，超段丢弃
  return { providerId: parts[0], modelId: parts[1], level: parts[2] || undefined };
}

// 三层合并：manual（BRIDGE_MODELS）→ live（session/read available）→ config（provider_config.json）
function mergedModelEntries(s) {
  const entries = [];
  for (const m of ENV_MODELS) {
    entries.push({ providerId: s.providerId, modelId: m.modelId, name: m.modelId, description: '手动添加（BRIDGE_MODELS）', source: 'manual' });
  }
  for (const mo of s.liveModels || []) {
    const pid = mo.ref?.providerId || s.providerId;
    entries.push({
      providerId: pid, modelId: mo.ref?.modelId,
      name: (mo.label || mo.ref?.modelId) + (mo.providerLabel ? ` · ${mo.providerLabel}` : ''),
      providerLabel: mo.providerLabel,
      description: mo.description || undefined, source: 'live',
    });
  }
  for (const m of configLayerModels()) {
    entries.push({ providerId: m.providerId, modelId: m.modelId, name: m.modelId, description: undefined, source: 'config' });
  }
  // 当前模型兜底入选（session/read 失败/清空时 UI 仍能标出在用模型）
  const cur = decodeModelValue(s.currentModelId);
  if (cur && !entries.some(e => e.providerId === cur.providerId && e.modelId === cur.modelId)) {
    entries.unshift({ providerId: cur.providerId, modelId: cur.modelId, name: cur.modelId, description: '当前模型', source: 'live' });
  }
  // 按 provider␟model 去重，先到先得（manual > live > config 的顺序即优先级）
  const seen = new Set();
  return entries.filter(e => {
    if (!e.modelId) return false;
    const key = encModelValue(e.providerId, e.modelId);
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

function buildConfigOptions(s) {
  if (!CONFIG_OPTIONS_ON) return []; // v0.1 兼容档：宿主只见 models/modes 块
  const entries = mergedModelEntries(s);
  const cur = decodeModelValue(s.currentModelId);
  const currentValue = cur ? encModelValue(cur.providerId, cur.modelId) : (entries[0] ? encModelValue(entries[0].providerId, entries[0].modelId) : '');

  // 单 provider 平铺；多 provider 用 v1 服务端分组（group=providerId, name=providerLabel）
  const providerIds = [...new Set(entries.map(e => e.providerId))];
  let options;
  if (providerIds.length > 1) {
    const groupLabels = new Map();
    for (const e of entries) if (!groupLabels.has(e.providerId)) groupLabels.set(e.providerId, e.source === 'manual' ? '手动添加' : (e.providerLabel || e.providerId));
    const cfg = readZcodeProviderConfig();
    for (const [pid, label] of groupLabels) if (cfg?.providers?.get(pid)?.label) groupLabels.set(pid, cfg.providers.get(pid).label);
    options = providerIds.map(pid => ({
      group: pid,
      name: groupLabels.get(pid) || pid,
      options: entries.filter(e => e.providerId === pid).map(e => ({ value: encModelValue(e.providerId, e.modelId), name: e.name, ...(e.description ? { description: e.description } : {}) })),
    }));
  } else {
    options = entries.map(e => ({ value: encModelValue(e.providerId, e.modelId), name: e.name, ...(e.description ? { description: e.description } : {}) }));
  }

  const modelOption = {
    id: 'model', // id + category 双信号（codeg 前端 isModelConfigOption / 后端 is_model_config_option 各认一个）
    name: '模型',
    category: 'model',
    type: 'select',
    currentValue,
    options,
  };

  const configOptions = [modelOption];

  // 思考深度（zcode session/setThoughtLevel；available 来自 session/read）。
  // category 用 ACP 原生 "thought_level"：codeg 的 isModelConfigOption 按 id==="model" ||
  // category==="model" 识别模型选择器，"model" 会把本选项误并入模型分组。
  if (THOUGHT_ON && s.thoughtLevels && s.thoughtLevels.available.length) {
    const tl = s.thoughtLevels;
    configOptions.push({
      id: 'reasoning_effort',
      name: '思考深度',
      category: 'thought_level',
      type: 'select',
      currentValue: tl.available.some(a => a.value === tl.current) ? tl.current : (tl.available[0]?.value || ''),
      options: tl.available.map(a => ({ value: a.value, name: a.label })),
    });
  }
  // 模式（codeg 的 UI 互斥规则：有 configOptions 就不渲染 modes 块的模式选择器——
  // 不补这条，build/plan/yolo 在 codeg 里将不可达。MindFS 兼容档下 modes/set_mode 通道照旧）
  configOptions.push({
    id: 'mode',
    name: '模式',
    category: 'mode',
    type: 'select',
    currentValue: ZCODE_MODES.some(m => m.id === s.currentMode) ? s.currentMode : ZCODE_MODES[0].id,
    options: ZCODE_MODES.map(m => ({ value: m.id, name: m.name })),
  });
  return configOptions;
}

// v0.1 兼容层：models/modes 块是本桥的私有扩展（非 ACP schema——MindFS 消费；标准宿主如 codeg
// 忽略不解析）。编码 provider␟model[␟level]，env 层带 level。
function acpModelsBlock(s) {
  const entries = mergedModelEntries(s);
  const envSet = new Set(ENV_MODELS.map(m => m.modelId));
  let models = entries.map(e => {
    const env = ENV_MODELS.find(m => m.modelId === e.modelId);
    const level = env?.level;
    return {
      ref: { providerId: e.providerId, modelId: e.modelId, ...(level ? { level } : {}) },
      modelId: encModelValue(e.providerId, e.modelId) + (level ? `${SEP}${level}` : ''),
      name: e.name,
      description: e.description,
    };
  });
  if (!models.length) models = [{ modelId: `default${SEP}default`, name: '默认模型（清单读取失败）' }];
  return { availableModels: models, currentModelId: s.currentModelId || models[0].modelId };
}

function acpModesBlock(s) {
  return {
    availableModes: ZCODE_MODES.map(m => ({ id: m.id, name: m.name })),
    currentModeId: s.currentMode,
  };
}

// 宣告 /compact（宿主斜杠菜单；name/description 均必填，缺 description 的条目会被宿主静默丢弃）
// ⚠️ 字段名是 availableCommands（ACP schema v1 AvailableCommandsUpdate 必填字段）——
// 用 "commands" 会被 codeg 的 serde 判缺字段，整帧静默丢弃，斜杠菜单永远不出 /compact。
function pushAdvertisedCommands(sid) {
  if (!COMPACT_ON) return;
  notifySessionUpdate(sid, { sessionUpdate: 'available_commands_update', availableCommands: COMPACT_COMMANDS });
}

// 会话中模型/思考深度变更后重推（建立期走 session/new|load|resume 响应内嵌 configOptions）
function pushConfigOptions(s) {
  if (!CONFIG_OPTIONS_ON) return; // v0.1 兼容档：不发新通知类型
  notifySessionUpdate(s.zsid, { sessionUpdate: 'config_option_update', configOptions: buildConfigOptions(s) });
}

// 历史回放：user text → user_message_chunk；assistant text → agent_message_chunk；tool → tool_call(completed)
function replayHistory(s, zsid, msgs) {
  for (const msg of msgs || []) {
    const role = msg.info?.role;
    for (const part of msg.parts || []) {
      if (part.type === 'text' && part.text) {
        notifySessionUpdate(zsid, role === 'user'
          ? { sessionUpdate: 'user_message_chunk', content: { type: 'text', text: part.text } }
          : { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: part.text } });
      } else if (role === 'assistant' && part.type === 'tool' && part.state?.status) {
        const toolCallId = part.toolCallId || part.partId;
        s.seenToolCalls.set(toolCallId, part.state.title || part.toolName || 'tool');
        notifySessionUpdate(zsid, {
          sessionUpdate: 'tool_call', toolCallId,
          title: part.state.title || part.toolName || 'tool',
          kind: toolKindOf(part.toolName),
          status: part.state.status === 'error' ? 'failed' : 'completed',
          rawInput: part.state.input,
        });
      }
    }
  }
}

// session/load 与 session/resume 共用的收尾：读模型清单 → yolo → 订阅
async function finishResumedSession(zc, zsid, s) {
  try {
    const rd = await zc.request('session/read', { sessionId: zsid }, 20000);
    absorbSessionSettings(s, rd);
  } catch (e) { log('session/read after resume failed', String(e)); }
  // 与 initZcodeSession 相同的三层合并语义，保证恢复后的会话清单一致
  s.models = acpModelsBlock(s).availableModels;
  if (PERM_MODE === 'allow') {
    // 宿主显式设过模式（set_mode / set_config_option('mode')）→ 恢复它；否则 allow 档默认 yolo。
    // 盲目强切 yolo 会静默覆盖 plan 的只读约束，且 respawn 对宿主不可见（codeg 偏好回放只在
    // attach 时执行一次），UI/zcode/桥三方漂移。
    const target = s.explicitMode && ZCODE_MODES.some(m => m.id === s.explicitMode) ? s.explicitMode : 'yolo';
    try { await zc.request('session/setMode', { sessionId: zsid, mode: target }, 10000); s.currentMode = target; } catch {}
  }
  await zc.request('session/subscribe', { sessionId: zsid, deliveryKind: 'desktop-continuous' }, 15000); // 失败随 load/resume 一起报给宿主
}

// 子进程存活保证：被闲置回收/意外退出后，用原生 session/resume 重建（上下文在 zcode 侧持久，不丢）
async function ensureZcode(s) {
  if (s.zc && s.zc.child.exitCode === null && !s.zc.child.killed) {
    s.lastActivity = Date.now(); // 存活分支也刷新：set_config_option 等非 prompt 操作不该被回收器截杀
    return s.zc;
  }
  // 并发去重：respawn 窗口（最长 45s resume）内到达的多个请求共用一次重建，防双 spawn 孤儿
  if (s._respawn) return s._respawn;
  s._respawn = (async () => {
    log('respawning zcode child', s.zsid);
    acquireSpawnSlot();
    const zc = spawnZcode(s.cwd);
    try {
      await zc.request('session/resume', { sessionId: s.zsid, workspace: { workspacePath: s.cwd, workspaceKey: s.workspaceKey } }, 45000);
      // close 撞 respawn：respawn 期间 s.zc 为 null、close 的 kill 落空——不查 closed 就把
      // ~300MB 子进程挂回已删除的会话对象，回收器再也够不到（孤儿 + 上下文泄漏）
      if (s.closed) { zc.kill(); throw new Error('session closed during respawn'); }
      s.zc = zc;
      s.lastActivity = Date.now();
      await finishResumedSession(zc, s.zsid, s);
      if (s.closed) { zc.kill(); throw new Error('session closed during respawn'); }
      pushConfigOptions(s); // respawn 对宿主不可见（无偏好回放）：重推一次让选择器与实际状态对齐
      return zc;
    } catch (e) { zc.kill(); throw e; } // resume 失败/超时也杀子进程，防泄漏
    finally { releaseSpawnSlot(); }
  })().finally(() => { s._respawn = null; });
  return s._respawn;
}

// ---------- set_config_option 应用（串行闸内执行） ----------
async function applyConfigOption(s, zc, configId, value) {
  if (configId === 'model') {
    const dec = decodeModelValue(value);
    if (!dec) throw new Error(`invalid model value (expected providerId${SEP}modelId): ${value}`);
    const model = { providerId: dec.providerId, modelId: dec.modelId };
    if (dec.level) model.options = { reasoningLevel: dec.level };
    try {
      await zc.request('session/setModel', { sessionId: s.zsid, model }, 15000);
    } catch (e) {
      const msg = String(e?.message || e);
      if (!dec.level && /reasoning/i.test(msg)) {
        // 该模型强制要求 reasoning 级别 → 回落 low（currentValue 仍保持用户所选，不带 level）
        await zc.request('session/setModel', { sessionId: s.zsid, model: { ...model, options: { reasoningLevel: 'low' } } }, 15000);
      } else throw e;
    }
    s.currentModelId = encModelValue(dec.providerId, dec.modelId) + (dec.level ? `${SEP}${dec.level}` : '');
    // 重读一次，吸收 zcode 侧真实状态（current/available/thoughtLevel 都可能因切模型而变）
    try {
      const rd = await zc.request('session/read', { sessionId: s.zsid }, 20000);
      absorbSessionSettings(s, rd);
      // absorb 会用 zcode 实际 current 覆盖 currentModelId（可能带 level）——保持无 level 视图供 UI 匹配
      if (rd?.result?.settings?.model?.current?.providerId) {
        s.currentModelId = encModelValue(rd.result.settings.model.current.providerId, rd.result.settings.model.current.modelId);
      }
    } catch (e) { log('session/read after setModel failed', String(e)); }
    return;
  }
  if (configId === 'reasoning_effort') {
    if (!/^[a-z0-9_-]+$/i.test(value)) throw new Error(`invalid thoughtLevel value: ${value}`);
    await zc.request('session/setThoughtLevel', { sessionId: s.zsid, thoughtLevel: value }, 10000);
    if (s.thoughtLevels) s.thoughtLevels.current = value;
    return;
  }
  if (configId === 'mode') {
    const mode = ZCODE_MODES.some(m => m.id === value) ? value : null;
    if (!mode) throw new Error(`unsupported mode: ${value}`);
    await zc.request('session/setMode', { sessionId: s.zsid, mode }, 15000);
    s.currentMode = mode;
    s.explicitMode = mode; // respawn 时恢复宿主的显式选择，而非强切 yolo
    return;
  }
  const err = new Error(`unknown config option: ${configId}`);
  err.code = -32602;
  throw err;
}

// ---------- ACP 请求分发 ----------
async function handleAcpRequest(id, method, params) {
  // 响应后执行的工作（如 config_option_update 重推）：load/resume 的清单重推必须在响应之后，
  // 否则会跟宿主的偏好回放产生"暂存旧值视觉覆盖"的顺序问题
  const postResponse = [];
  try {
    let result;
    switch (method) {
      case 'initialize':
        result = {
          protocolVersion: ACP_PROTOCOL_VERSION,
          agentCapabilities: {
            loadSession: true,
            promptCapabilities: { audio: false, embeddedContext: false, image: false },
            sessionCapabilities: { close: {}, resume: {} },
          },
          agentInfo: { name: 'zcode-acp-bridge', version: '0.4.0' },
          authMethods: [],
        };
        break;

      case 'session/new': {
        const cwd = params?.cwd || process.cwd();
        assertCwd(cwd);
        acquireSpawnSlot(); // 每个会话一个 zcode 子进程 ~300MB：new/load/resume/respawn 全局过闸
        let s;
        try { s = await createZcodeSession(cwd); } finally { releaseSpawnSlot(); }
        const prev = sessions.get(s.zsid); // 理论上 zcode 不会复用 sessionId；真发生时收掉旧子进程防孤儿
        if (prev) prev.zc?.kill();
        sessions.set(s.zsid, s);
        sessionCwds.set(s.zsid, cwd);
        // 预响应推送可用（宿主 runtime 对带 sessionId 的未认领通知暂存重放）；命令无 set 语义，安全
        pushAdvertisedCommands(s.zsid);
        // 建立期 configOptions 走响应内嵌（宿主按此做偏好回放，顺序安全）；v0.1 兼容档整个不发——
        // 空数组与缺字段对 codeg 不同（hasConfigOptions 判存在性），必须省键让宿主回退 modes 通道
        result = { sessionId: s.zsid, models: acpModelsBlock(s), modes: acpModesBlock(s),
          ...(CONFIG_OPTIONS_ON ? { configOptions: buildConfigOptions(s) } : {}) };
        break;
      }

      case 'session/load': {
        const cwd = params?.cwd || process.cwd();
        const zsid = params?.sessionId;
        if (!zsid) throw new Error('session/load: missing sessionId');
        assertCwd(cwd);
        // 归属校验：zcode 侧 resume 只按 sessionId 取会话、不比对 workspace——桥必须自己挡
        // "把别的 cwd 的会话挂进当前 workspace"（历史回放会泄漏到错误的 UI，新 turn 换了工作目录）
        const knownCwd = sessionCwds.get(zsid);
        if (knownCwd && knownCwd !== cwd) {
          const err = new Error(`session ${zsid} belongs to another workspace`);
          err.code = -32602;
          throw err;
        }
        // 重复 load（UI 重连等）：复用条目不重复 spawn，但历史要重新回放（宿主重连后 UI 是空的）
        if (sessions.has(zsid)) {
          const s0 = sessions.get(zsid);
          if (s0.cwd !== cwd) {
            const err = new Error(`session ${zsid} belongs to another workspace (${s0.cwd})`);
            err.code = -32602;
            throw err;
          }
          const zc0 = await ensureZcode(s0);
          const rr0 = await zc0.request('session/resume', { sessionId: zsid }, 20000);
          replayHistory(s0, zsid, rr0.result?.messages || []);
          await finishResumedSession(zc0, zsid, s0);
          result = { models: acpModelsBlock(s0), modes: acpModesBlock(s0) };
          postResponse.push(() => pushConfigOptions(s0));
          break;
        }
        if (resumeInFlight.has(zsid)) { // 并发 load 同 zsid：等第一个的 spawn+回放完成，共用其结果（R7-B1）
          const s2 = await resumeInFlight.get(zsid);
          result = { models: acpModelsBlock(s2), modes: acpModesBlock(s2) };
          postResponse.push(() => pushConfigOptions(s2));
          break;
        }
        acquireSpawnSlot();
        const zc = spawnZcode(cwd);
        // 单飞：并发 load/resume 同一 zsid 只 spawn 一次——并发窗口内两个请求都会走到这里，
        // 各自 spawn 会造成双子进程 + 双回放，后入册者覆盖前者还漏收尸（R7-B1）
        const flight = (async () => {
          try {
            const rr = await zc.request('session/resume', { sessionId: zsid, workspace: { workspacePath: cwd, workspaceKey: workspaceKeyOf(cwd) } }, 45000);
            const s = newSessionState(zc, zsid, cwd, workspaceKeyOf(cwd));
            replayHistory(s, zsid, rr.result?.messages || []);
            await finishResumedSession(zc, zsid, s);
            return s;
          } catch (e) { zc.kill(); throw e; } // resume/回放失败/超时也杀子进程，防泄漏
        })();
        resumeInFlight.set(zsid, flight);
        let s;
        try { s = await flight; } finally { resumeInFlight.delete(zsid); releaseSpawnSlot(); } // 单点释放（R8-n5）
        if (pendingClose.delete(zsid)) { s.zc.kill(); throw new Error('session closed before load completed'); } // close 竞速：不入册（R7-m4）
        const prevL = sessions.get(zsid); // 覆盖防御：同 zsid 旧条目（close 后立刻 load 等）先收尸
        if (prevL) prevL.zc?.kill();
        sessions.set(zsid, s);
        sessionCwds.set(zsid, cwd);
        result = { models: acpModelsBlock(s), modes: acpModesBlock(s) };
        pushAdvertisedCommands(zsid);
        postResponse.push(() => pushConfigOptions(s)); // load 无建立期偏好回放通道：响应后重推（无 set 语义竞态）
        break;
      }

      // ACP session/resume（老宿主重启后走这条）：不回放消息——zcode app-server 原生记得全部上下文
      case 'session/resume': {
        const cwd = params?.cwd || process.cwd();
        const zsid = params?.sessionId;
        if (!zsid) throw new Error('session/resume: missing sessionId');
        assertCwd(cwd);
        const knownCwd = sessionCwds.get(zsid);
        if (knownCwd && knownCwd !== cwd) {
          const err = new Error(`session ${zsid} belongs to another workspace`);
          err.code = -32602;
          throw err;
        }
        if (sessions.has(zsid)) {
          const s0 = sessions.get(zsid);
          if (s0.cwd !== cwd) {
            const err = new Error(`session ${zsid} belongs to another workspace (${s0.cwd})`);
            err.code = -32602;
            throw err;
          }
          const zc0 = await ensureZcode(s0);
          await finishResumedSession(zc0, zsid, s0);
          result = { models: acpModelsBlock(s0), modes: acpModesBlock(s0) };
          postResponse.push(() => pushConfigOptions(s0));
          break;
        }
        if (resumeInFlight.has(zsid)) { // 并发 resume/load 同 zsid：等第一个的 spawn 完成，共用其结果（R7-B1）
          const s2 = await resumeInFlight.get(zsid);
          result = { models: acpModelsBlock(s2), modes: acpModesBlock(s2) };
          postResponse.push(() => pushConfigOptions(s2));
          break;
        }
        acquireSpawnSlot();
        const zc = spawnZcode(cwd);
        const flight = (async () => {
          try {
            const rr = await zc.request('session/resume', { sessionId: zsid, workspace: { workspacePath: cwd, workspaceKey: workspaceKeyOf(cwd) } }, 45000);
            const s = newSessionState(zc, zsid, cwd, workspaceKeyOf(cwd));
            await finishResumedSession(zc, zsid, s);
            return s;
          } catch (e) { zc.kill(); throw e; } // resume 失败/超时也杀子进程，防泄漏
        })();
        resumeInFlight.set(zsid, flight);
        let s;
        try { s = await flight; } finally { resumeInFlight.delete(zsid); releaseSpawnSlot(); } // 单点释放（R8-n5）
        if (pendingClose.delete(zsid)) { s.zc.kill(); throw new Error('session closed before resume completed'); } // close 竞速：不入册（R7-m4）
        const prevR = sessions.get(zsid);
        if (prevR) prevR.zc?.kill();
        sessions.set(zsid, s);
        sessionCwds.set(zsid, cwd);
        result = { models: acpModelsBlock(s), modes: acpModesBlock(s) };
        pushAdvertisedCommands(zsid);
        postResponse.push(() => pushConfigOptions(s));
        break;
      }

      case 'session/prompt': {
        const s = sessions.get(params?.sessionId);
        if (!s) throw new Error(`unknown session: ${params?.sessionId}`);
        const blocks = params?.prompt || [];
        const textBlocks = blocks.filter(b => b?.type === 'text');
        const firstText = (textBlocks[0]?.text || '').trim();
        const compactMatch = COMPACT_ON ? COMPACT_RE.exec(firstText) : null;
        if (compactMatch) {
          // /compact 手动压缩：本地分派，不直通 zcode 烧普通 prompt
          if (s.busy || s.turnWaiter) throw new Error('prompt already in flight');
          s.busy = true;
          try {
            s.lastActivity = Date.now();
            const zc = await ensureZcode(s);
            if (s.cancelRequested) { // 同 prompt：重建窗口内的 cancel 直接收口
              s.cancelRequested = false;
              result = { stopReason: 'cancelled' };
              break;
            }
            const myTurn = ++INPUT_SEQ; // 进程级单调代际令牌：close→load 复用 sessionId 也不撞号（R7-m6）
            const inputId = `${s.zsid}/${myTurn}`; // 精确归属：already_running 跟随时靠它认领在飞压缩的终结
            s.activeInputId = inputId;
            const instructions = (compactMatch[1] || '').trim();
            const cparams = { sessionId: s.zsid, inputId };
            if (instructions) cparams.instructions = instructions;
            // 时序三连（缺一不可）：
            //   compaction 态先置 —— part.upserted(compaction) 与请求响应同 chunk 时回调先于本协程恢复；
            //   waiter 先挂 —— 终结事件与响应同 chunk 时不至于被判 stale；
            //   代际证据清零 —— 只认本轮 turn.started 之后的终结事件。
            s.compaction = { id: `zcode-compact-${++s.compactSeq}`, pre: undefined, post: undefined, summary: undefined };
            const done = new Promise((resolve) => {
              s.turnWaiter = { resolve, turn: myTurn };
              s.sawTurnStarted = false; s.bufferedTurnEnd = null;
              // 压缩也是一轮 turn；同样的看门狗保险丝
              s.turnWaiter.timer = setTimeout(() => {
                if (s.turnWaiter?.turn === myTurn) {
                  log('compact watchdog fired');
                  // 同 prompt 看门狗：僵尸压缩 turn 占住会话，后续 send/compact 全被 -32010 拒
                  s.zc?.request('session/stop', { sessionId: s.zsid }, 10000).catch(() => {});
                  if (s.compaction) emitCompactionCard(s, 'failed', 'compaction watchdog timeout');
                  endTurn(s, 'end_turn');
                }
              }, TURN_WATCHDOG_MS);
            });
            s.pendingTurnOp = true;
            let rrCompact;
            try {
              rrCompact = await requestTurnOpWithRetry(zc, s, 'session/compact', cparams, 30000);
            } catch (e) {
              s.pendingTurnOp = false;
              if (e?.zcodeCode === -32010) s.activeInputId = null; // 被 zcode 拒绝、turn 从未开跑：不转 foreign（R7-m1）
              endTurn(s, 'end_turn'); // 释放 waiter/看门狗（事件可能已在途）
              throw new Error(`session/compact failed: ${String(e?.message || e).slice(0, 200)}`);
            }
            s.pendingTurnOp = false;
            // 真实 zcode：state ∈ accepted|already_running。已在压缩中→不重复发卡（否则卡片计数错位），
            // 但 turn.started/completed 照常广播，waiter 继续等后台那轮收口
            const cstate = rrCompact?.result?.state || rrCompact?.result?.compact?.state;
            if (cstate === 'already_running') {
              // 已在压缩中：跟随模式——保留 compaction 态并补发 in_progress 卡，本 turn 由
              // 在飞那轮压缩的终结事件收口（其 inputId 早随 cancel/看门狗转入 foreignInputIds，
              // 终结到达时走 foreign 分支 finishTurn → 照常发 completed/failed 卡）。
              // 旧实现（compaction=null + 代际手工作证）会让这轮收口后宿主看到一条永远悬着的卡。
              log('compact already running, following its turn');
              s.followForeign = true; // 跟随态：在飞压缩的 foreign 终结获准收当前 waiter
              if (s.turnWaiter && !s.compaction.inProgressSent) emitCompactionCard(s, 'in_progress');
              // 旧 zcode（终结事件不带 inputId）兜底：在飞压缩的 turn.started 早已过去（先于本
              // waiter）——代际证据手工作证，否则它的 turn.completed 会被三重身份判定吞掉，
              // 本 prompt 挂到看门狗。新 zcode 终结带 inputId 走精确归属，此行对它无效果。
              s.sawTurnStarted = true;
              notifySessionUpdate(s.zsid, { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: '[zcode] 压缩已在进行中，等待其完成' } });
            } else if (s.turnWaiter && !s.compaction.inProgressSent) {
              // 请求成功后补发 in_progress 卡；若已被 cancel/缓冲收口则无需再发
              emitCompactionCard(s, 'in_progress');
            }
            // 同 chunk 情形：终结事件先于本协程恢复到达，已缓存——现在 waiter 已挂，立即重放
            if (s.bufferedTurnEnd) { const b = s.bufferedTurnEnd; s.bufferedTurnEnd = null; finishTurn(s, s.zsid, b.kind, b.p); }
            // already_running 同 chunk 的另一形态：在飞压缩（foreign inputId）的终结先于响应到达，
            // 已缓存到 bufferedForeignEnd——响应处理完后重放收口
            if (cstate === 'already_running' && s.bufferedForeignEnd && s.turnWaiter) {
              const b = s.bufferedForeignEnd; s.bufferedForeignEnd = null;
              finishTurn(s, s.zsid, b.kind, b.p);
            }
            result = { stopReason: (await done).stopReason || 'end_turn' };
          } finally { s.busy = false; s.compaction = null; s.cancelRequested = false; s.followForeign = false; }
          break;
        }
        const text = textBlocks.map(b => b.text).join('\n');
        if (!text) throw new Error('session/prompt: no text content');
        if (text.length > PROMPT_MAX_CHARS) {
          const err = new Error(`prompt too large (${text.length} chars, max ${PROMPT_MAX_CHARS})`);
          err.code = -32602;
          throw err;
        }
        // 忙闸在任何 await 之前同步落下：两个 prompt 交错进来时后到者直接被拒，不会互相覆盖 waiter
        if (s.busy || s.turnWaiter) throw new Error('prompt already in flight');
        s.busy = true;
        try {
          s.lastActivity = Date.now(); // 先记活跃再重建，防回收器在 ensureZcode 窗口开杀
          const zc = await ensureZcode(s); // 子进程可能已被闲置回收：透明重建
          if (s.cancelRequested) {
            // cancel 落在重建窗口内（ensureZcode 在飞时到达）：按 ACP 语义直接 cancelled 收口，
            // 重建出的子进程不再开新 turn
            s.cancelRequested = false;
            result = { stopReason: 'cancelled' };
            break;
          }
          const myTurn = ++INPUT_SEQ; // 进程级单调代际令牌：看门狗只认自己这轮，close→load 复用 id 也不撞号（R7-m6）
          const inputId = `${s.zsid}/${myTurn}`; // 精确归属：zcode 3.14+ 在 turn 事件中回显
          s.activeInputId = inputId;
          // waiter 先挂再写 send：zcode 把响应与终结事件合并进同一 chunk 时，事件回调先于
          // 本协程恢复执行——waiter 后挂的话终结事件会被判 stale，prompt 挂到看门狗
          const done = new Promise((resolve) => {
            s.turnWaiter = { resolve, turn: myTurn };
            s.sawTurnStarted = false; s.bufferedTurnEnd = null;
            s.turnWaiter.timer = setTimeout(() => {
              if (s.turnWaiter?.turn === myTurn) {
                log('turn watchdog fired');
                // zcode 侧 turn 可能仍在跑：发 stop 杀掉，否则僵尸 turn 占住会话，
                // 后续 session/send 全被 -32010（prompt already running）拒绝
                s.zc?.request('session/stop', { sessionId: s.zsid }, 10000).catch(() => {});
                endTurn(s, 'end_turn');
              }
            }, TURN_WATCHDOG_MS);
          });
          s.pendingTurnOp = true;
          try {
            await requestTurnOpWithRetry(zc, s, 'session/send', { sessionId: s.zsid, content: text, inputId }, 30000);
          } catch (e) {
            s.pendingTurnOp = false;
            if (e?.zcodeCode === -32010) s.activeInputId = null; // 被 zcode 拒绝、turn 从未开跑：不转 foreign（R7-m1）
            endTurn(s, 'end_turn'); // 释放 waiter/看门狗；turn 可能已在 zcode 侧开跑（非 -32010 失败），事件成了 stale
            throw new Error(`session/send failed: ${String(e?.message || e).slice(0, 200)}`);
          }
          s.pendingTurnOp = false;
          if (s.bufferedTurnEnd) { const b = s.bufferedTurnEnd; s.bufferedTurnEnd = null; finishTurn(s, s.zsid, b.kind, b.p); }
          // send 前被 cancel 收走的轮次：done 已 resolve cancelled，直接透传
          result = { stopReason: (await done).stopReason || 'end_turn' };
        } finally { s.busy = false; s.cancelRequested = false; }
        break;
      }

      case 'session/set_mode': {
        const s = sessions.get(params?.sessionId);
        if (!s) throw new Error(`unknown session: ${params?.sessionId}`);
        const mode = ZCODE_MODES.some(m => m.id === params?.modeId) ? params.modeId : null;
        if (!mode) throw new Error(`unsupported mode: ${params?.modeId}`);
        const zc = await ensureZcode(s);
        await zc.request('session/setMode', { sessionId: s.zsid, mode }, 15000);
        s.currentMode = mode;
        s.explicitMode = mode; // respawn 时恢复宿主的显式选择，而非强切 yolo
        result = {};
        break;
      }

      // v0.1 兼容层：MindFS 模型切换走这条（v0.2 起 codeg 走 set_config_option，此方法对它无副作用——
      // session/set_model 是稳定 ACP schema 已废弃的方法，codeg 仅 Grok 专用路径消费）。缺了它 MindFS 切模型必报 -32601。
      case 'session/set_model': {
        const s = sessions.get(params?.sessionId);
        if (!s) throw new Error(`unknown session: ${params?.sessionId}`);
        // 编码 provider␟model[␟level]（level 可选，本桥发放的 modelId 自带）
        const parts = String(params?.modelId || '').split(SEP);
        if (parts.length < 2) throw new Error(`modelId must be providerId${SEP}modelId (issued by this bridge)`);
        const [providerId, modelId, level] = parts;
        const model = { providerId, modelId };
        if (level) model.options = { reasoningLevel: level };
        let applied = params.modelId;
        const zc = await ensureZcode(s);
        try {
          await zc.request('session/setModel', { sessionId: s.zsid, model }, 15000);
        } catch (e) {
          const msg = String(e?.message || e);
          if (!level && /reasoning/i.test(msg)) {
            // 该模型强制要求 reasoning 级别 → 回落 low
            await zc.request('session/setModel', { sessionId: s.zsid, model: { ...model, options: { reasoningLevel: 'low' } } }, 15000);
            applied = `${params.modelId}${SEP}low`;
          } else throw e;
        }
        s.currentModelId = applied;
        s.providerId = providerId;
        result = {};
        break;
      }

      case 'session/set_config_option': {
        const s = sessions.get(params?.sessionId);
        if (!s) throw new Error(`unknown session: ${params?.sessionId}`);
        const configId = String(params?.configId || '');
        // v1：select 的 value 是平铺裸字符串；boolean 才带 type:"boolean"（本桥不宣告 boolean 选项）
        if (params?.type === 'boolean' || typeof params?.value === 'boolean') {
          const err = new Error(`config option ${configId} does not accept boolean values`);
          err.code = -32602;
          throw err;
        }
        const value = typeof params?.value === 'string' ? params.value : String(params?.value ?? '');
        if (!value) {
          const err = new Error('config option value is required');
          err.code = -32602;
          throw err;
        }
        // 串行闸：模型/思考深度连切时按到达顺序落盘，避免两笔 setModel/setThoughtLevel 交错。
        // ensureZcode 放闸内：排队期间子进程可能死亡重建，闸外取的 zc 会写进虚空
        if (s.opDepth >= 32) {
          // 积压深度闸：宿主洪泛式连发会小时级排队（每笔都可能触发子进程重建）——直接拒绝
          const err = new Error('config option backlog too deep');
          err.code = -32603;
          throw err;
        }
        s.opDepth++;
        const run = s.opQueue.then(async () => {
          try {
            const zc2 = await ensureZcode(s);
            return await applyConfigOption(s, zc2, configId, value);
          } finally { s.opDepth--; }
        });
        s.opQueue = run.catch(() => {});
        await run;
        // 应答必须携带完整清单（SetSessionConfigOptionResponse）；宿主据此刷新选择器
        result = { configOptions: buildConfigOptions(s) };
        break;
      }

      case 'session/close': {
        const s = sessions.get(params?.sessionId);
        if (s) {
          s.closed = true;
          if (s.turnWaiter) endTurn(s, 'cancelled'); // 先收口在飞 prompt，别让 exit 收尸找不到会话条目
          s.zc?.kill(); // 回收后 s.zc 为 null：照样算关掉
          sessions.delete(params.sessionId);
        } else if (resumeInFlight.has(params?.sessionId)) {
          // close 与在飞 load/resume 竞速：标记之，spawn 完成后不入册直接收尸（R7-m4）
          pendingClose.add(params.sessionId);
        }
        result = {};
        break;
      }

      case 'authenticate':
        result = {};
        break;

      default: {
        const err = new Error(`Method not found: ${method}`);
        err.code = -32601;
        throw err;
      }
    }
    acpSend({ id, result });
    for (const fn of postResponse.splice(0)) {
      try { await fn(); } catch (e) { log('post-response work failed', String(e).slice(0, 200)); }
    }
  } catch (e) {
    const err = e && e.code ? { code: e.code, message: e.message } : { code: -32603, message: String(e?.message || e) };
    log('ACP error', method, JSON.stringify(err));
    acpSend({ id, error: err });
  }
}

// ---------- ACP stdin 读取 ----------
let inBuf = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (d) => {
  inBuf += d;
  let i;
  while ((i = inBuf.indexOf('\n')) >= 0) {
    const line = inBuf.slice(0, i); inBuf = inBuf.slice(i + 1);
    if (!line.trim()) continue;
    let m; try { m = JSON.parse(line); } catch (e) {
      // R8-M1：此处是桥唯一会把"宿主原文"落盘的汇点——只记长度+首 16 字节 hex，
      // 不落行内容（畸形行里可能是被截断的密钥/prompt 正文）
      log('ACP parse error', { len: line.length, head: Buffer.from(line, 'utf8').subarray(0, 16).toString('hex') });
      continue;
    }
    if (m.id !== undefined && m.method) {
      handleAcpRequest(m.id, m.method, m.params); // 异步，不阻塞读取
    } else if (m.method && m.id === undefined) {
      if (m.method === 'session/cancel') {
        const s = sessions.get(m.params?.sessionId);
        if (s) {
          // ACP 语义：被取消的 prompt 要尽快以 cancelled 收口（zcode 侧 stop 照发；子进程可能已被回收）。
          // cancelRequested 只标"send/compact 尚未写出"的窗口（busy 且无 waiter/pendingOp——典型是
          // ensureZcode 重建在飞）：prompt/compact 协程重建完成后据此直接收口。turn 已在跑时置位
          // 会泄漏到下一轮 prompt（误杀），故条件置位。
          s.cancelRequested = s.busy && !s.turnWaiter && !s.pendingTurnOp;
          if (s.zc) s.zc.request('session/stop', { sessionId: s.zsid }, 10000).catch(e => log('cancel/stop failed', String(e)));
          // failed 卡只在 in_progress 卡已发过后补发，避免"failed 抢跑 in_progress"的时序倒挂
          if (s.compaction && s.compaction.inProgressSent) emitCompactionCard(s, 'failed', 'cancelled by user');
          if (s.turnWaiter) { endTurn(s, 'cancelled'); s.busy = false; } // 忙闸同步放开：同 chunk [cancel,prompt] 不再被拒（R7-m2）；prompt 协程稍后的 finally 置 false 是幂等
        }
      } else if (m.method === 'session/set_session_mode' || m.method === 'session/set_session_model') {
        // 兼容个别客户端命名差异：忽略（MindFS 用标准名）
      } else {
        log('ACP notification (ignored)', m.method);
      }
    }
  }
  // 无换行的超长倾倒：整段丢弃，防 inBuf 无界增长
  if (inBuf.length > LINE_BUF_MAX) { log('stdin buffer overflow, dropping', { bytes: inBuf.length }); inBuf = ''; }
});
process.stdin.on('end', () => {
  log('stdin end, killing children');
  killAllChildren();
  setTimeout(() => process.exit(0), 300);
});
// 宿主/系统停桥走 SIGTERM：Node 默认直接终止不跑 exit 钩子，必须自己收尸
function killAllChildren() { for (const c of allChildren) { try { c.kill('SIGKILL'); } catch {} } }
for (const sig of ['SIGTERM', 'SIGINT']) {
  process.on(sig, () => { log('signal', sig, '— killing children and exiting'); killAllChildren(); setTimeout(() => process.exit(0), 300); });
}
process.on('exit', () => killAllChildren());
// 熔断：偶发异常吞掉保活；连发说明桥已处于未定义状态，继续吞只会以损坏状态服务——直接退出让宿主重启
let uncaughtCount = 0;
process.on('uncaughtException', (e) => {
  log('uncaughtException', String(e?.stack || e));
  if (++uncaughtCount >= 10) { log('uncaughtException circuit breaker tripped, exiting'); process.exit(1); }
});
process.on('unhandledRejection', (e) => { log('unhandledRejection', String(e?.stack || e)); });
